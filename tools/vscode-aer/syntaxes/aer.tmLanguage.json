{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AER",
  "scopeName": "source.aer",
  "fileTypes": ["aer"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#cast" },
    { "include": "#decl-names" },
    { "include": "#builtins" },
    { "include": "#modules" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#call-generic" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aer",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.aer",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.double.aer",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.aer",
          "match": "\\\\[ntr\\\\\"{]"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.aer",
          "begin": "(?<!\\\\)\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.aer" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.aer" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#cast" },
            { "include": "#builtins" },
            { "include": "#modules" },
            { "include": "#keywords" },
            { "include": "#constants" },
            { "include": "#call-generic" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.real.aer",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.aer",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "cast": {
      "patterns": [
        {
          "match": "\\b(as)\\b\\s*\\b(integer|float|string|boolean)\\b",
          "captures": {
            "1": { "name": "keyword.operator.word.aer" },
            "2": { "name": "support.type.aer" }
          }
        }
      ]
    },
    "decl-names": {
      "comment": "Must run before #keywords/#call-generic so the declared name gets a distinct scope instead of falling through to a bare keyword or generic call highlight.",
      "patterns": [
        {
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aer" },
            "2": { "name": "entity.name.function.aer" }
          }
        },
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.aer" },
            "2": { "name": "entity.name.type.aer" }
          }
        }
      ]
    },
    "builtins": {
      "comment": "Must run before #call-generic, or the generic 'identifier followed by (' rule wins these names first.",
      "patterns": [
        {
          "name": "support.function.builtin.aer",
          "match": "\\b(length|print|type|assert|panic|Result)\\b(?=\\s*\\()"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.module.aer",
          "match": "\\b(math|random|string|time|json|collection|net|regex|actor|scheduler|io)\\b(?=\\s*\\.)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aer",
          "match": "\\b(if|else|for|return|raise|break|continue)\\b"
        },
        {
          "name": "keyword.control.import.aer",
          "match": "\\b(import)\\b"
        },
        {
          "name": "keyword.declaration.aer",
          "match": "\\b(function|struct)\\b"
        },
        {
          "name": "keyword.operator.word.aer",
          "match": "\\b(in|as|and|or|not)\\b"
        },
        {
          "name": "storage.type.aer",
          "match": "\\b(integer|float|boolean|array|hashtable)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.aer",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "call-generic": {
      "comment": "Broadest identifier rule -- deliberately last among name-matching patterns so #decl-names/#builtins/#modules/#keywords/#constants all win first for names they specifically recognize.",
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.aer"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.aer",
          "match": "(\\+=|-=|\\*=|//=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.comparison.aer",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.pipe.aer",
          "match": "(\\|>)"
        },
        {
          "name": "keyword.operator.bitwise.aer",
          "match": "(<<|>>|~|\\^|&|\\|)"
        },
        {
          "name": "keyword.operator.range.aer",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.arithmetic.aer",
          "match": "(//|\\+|-|\\*|/|%)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.aer",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.array.aer",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.block.aer",
          "match": "[{}]"
        },
        {
          "name": "punctuation.separator.colon.aer",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.aer",
          "match": ","
        },
        {
          "name": "punctuation.accessor.aer",
          "match": "\\."
        }
      ]
    }
  }
}
