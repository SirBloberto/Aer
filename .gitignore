#Ignore binary files
/binary/*

#Ignore input files
/input/*

#Ignore object files
/object/*

/.vscode

#Scratch files written/overwritten by tests' own io round-trip tests
/tests/io_scratch.txt
/tests/io_mode_scratch.txt

#REPL history, written to the cwd by start_terminal()
/.aer_history

#Failing inputs saved by tests/fuzz.py — reproductions, not fixtures to keep
/tests/fuzz_crashes/

#gcov/coverage build artifacts
/object-cov/*
*.gcov
*.gcda
*.gcno

#PGO build artifacts
/object-pgo/*

#Profiling/debugging leftovers — never fixtures to keep
*.o
perf.data*
*.perf.data*

#Working conventions and local state for AI-assisted development — kept locally, not shipped
#in the public tree. Listed explicitly rather than relying on Windows' case-insensitive match
#of /CLAUDE.md against .claude/, which wouldn't hold on a case-sensitive filesystem.
/CLAUDE.md
/.claude/
