# battle.aer — a small turn-based combat simulator, written to exercise a
# broad slice of AER in one program: structs, the pipe operator, and the
# standard library (random, string).
#
# Run it with:
#   ./binary/aer examples/battle.aer

import random
import string

struct Character:
    name = "Unnamed"
    hp = 100
    attack = 10

# AER has no closures — a special attack's bonus is just an ordinary parameter,
# not state captured from an enclosing call.
function special_attack_damage(character, bonus):
    return character.attack + bonus

function deal_damage(target, amount):
    target.hp = target.hp - amount
    if target.hp < 0:
        target.hp = 0
    return target

function is_alive(character):
    return character.hp > 0

function status_line(character):
    n = character.name
    h = character.hp
    return "{n}: {h} HP"

function battle_round(attacker, defender, round_num):
    roll = random.randint(1, 6)
    damage = attacker.attack + roll
    defender = deal_damage(defender, damage)
    a = attacker.name
    d = defender.name
    print("Round {round_num}: {a} hits {d} for {damage} (roll {roll})")
    return defender

function print_summary(result):
    r = result["rounds"]
    w = result["winner"]
    print("--- battle over after {r} rounds — {w} wins ---")

function run_battle(hero, villain):
    result = {"rounds": 0, "winner": "nobody"}

    for round_num in 1..30:
        villain = battle_round(hero, villain, round_num)
        result["rounds"] = round_num
        if !is_alive(villain):
            result["winner"] = hero.name
            break

        hero = battle_round(villain, hero, round_num)
        result["rounds"] = round_num
        if !is_alive(hero):
            result["winner"] = villain.name
            break

    print_summary(result)
    return result["winner"]

random.seed(42)   # drop this line for a different battle every run

hero = Character("Aria", 120, 15)
villain = Character("Grothak", 100, 12)

print(status_line(hero) |> string.upper())
print(status_line(villain) |> string.upper())

special_damage = special_attack_damage(hero, 5)
hero_name = hero.name
print("{hero_name}'s special attack would deal {special_damage} damage.")
print("")

winner_name = run_battle(hero, villain)

print("")
print("{winner_name} is victorious!")
