#!/usr/bin/env aer
# AER test suite — a specialization recompile that grows the constant pool.
#
# vm_run_slice hoists c->pool into a local, and a shape-specializing recompile runs the parser
# again while that local is live. Recompiling the same source normally interns nothing new, because
# chunk_add_pool dedups by value -- but it dedups TYPE_FUNCTION on code_offset, and a specialized
# body's function expressions are emitted at NEW offsets. So a shape-sensitive function containing a
# lambda appends a pool entry on specialization, which can realloc the pool out from under the
# hoisted pointer. Every constant read for the rest of that slice then comes from freed memory.
#
# Each function below is shape-sensitive (it reads a struct field) AND contains a function
# expression, so each one appends on its first specialized call. Enough of them run that the pool
# crosses a growth boundary mid-slice. The constants read after are all distinct and all checked, so
# a stale pool pointer shows up as a wrong value rather than only as a crash.

struct Point:
    x = 0.0
    y = 0.0

function f0(p, k):
    g = function(a):
        return a * 2
    return p.x + p.y + g(k) + 1000.5

function f1(p, k):
    g = function(a):
        return a * 3
    return p.x + p.y + g(k) + 1001.5

function f2(p, k):
    g = function(a):
        return a * 4
    return p.x + p.y + g(k) + 1002.5

function f3(p, k):
    g = function(a):
        return a * 5
    return p.x + p.y + g(k) + 1003.5

function f4(p, k):
    g = function(a):
        return a * 6
    return p.x + p.y + g(k) + 1004.5

function f5(p, k):
    g = function(a):
        return a * 7
    return p.x + p.y + g(k) + 1005.5

function f6(p, k):
    g = function(a):
        return a * 8
    return p.x + p.y + g(k) + 1006.5

function f7(p, k):
    g = function(a):
        return a * 9
    return p.x + p.y + g(k) + 1007.5

pt = Point(10.0, 20.0)

# Each first call triggers the specialization recompile; the second confirms the specialized body
# is reused and still reads its constants correctly.
assert(f0(pt, 1) == 30.0 + 2.0 + 1000.5, "f0 before and after specialization")
assert(f0(pt, 1) == 30.0 + 2.0 + 1000.5, "f0 on the specialized body")
assert(f1(pt, 1) == 30.0 + 3.0 + 1001.5, "f1")
assert(f1(pt, 1) == 30.0 + 3.0 + 1001.5, "f1 specialized")
assert(f2(pt, 1) == 30.0 + 4.0 + 1002.5, "f2")
assert(f2(pt, 1) == 30.0 + 4.0 + 1002.5, "f2 specialized")
assert(f3(pt, 1) == 30.0 + 5.0 + 1003.5, "f3")
assert(f3(pt, 1) == 30.0 + 5.0 + 1003.5, "f3 specialized")
assert(f4(pt, 1) == 30.0 + 6.0 + 1004.5, "f4")
assert(f4(pt, 1) == 30.0 + 6.0 + 1004.5, "f4 specialized")
assert(f5(pt, 1) == 30.0 + 7.0 + 1005.5, "f5")
assert(f5(pt, 1) == 30.0 + 7.0 + 1005.5, "f5 specialized")
assert(f6(pt, 1) == 30.0 + 8.0 + 1006.5, "f6")
assert(f6(pt, 1) == 30.0 + 8.0 + 1006.5, "f6 specialized")
assert(f7(pt, 1) == 30.0 + 9.0 + 1007.5, "f7")
assert(f7(pt, 1) == 30.0 + 9.0 + 1007.5, "f7 specialized")

# Constants read AFTER all that growth, in the same slice, from the same hoisted pool pointer.
after = 12345.75
assert(after == 12345.75, "a constant read after the pool grew mid-slice")
assert(f0(pt, 2) == 30.0 + 4.0 + 1000.5, "an already-specialized body still reads its own constants")

print("test_spec_pool_realloc.aer: all assertions passed.")
