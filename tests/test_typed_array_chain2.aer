#!/usr/bin/env aer
# AER test suite — typed-array chain fusion (OP_TYPED_ARRAY_CHAIN2, vm.c; parse_binary_ops's
# lhs_is_chain2 detection, parser.c). `(A op1 B) op2 C` written as one expression fuses into a
# single pass with no intermediate array for (A op1 B) at all, when A/B/C all turn out to be
# matching-shape float32/float64 typed arrays at runtime; every other shape (plain scalars,
# mismatched typed arrays, int32/int64 typed arrays, an unfused-eligible operator) falls back to
# the exact unfused computation instead -- every result here must match exactly what two separate
# statements (`tmp = A op1 B; result = tmp op2 C`) would have produced.
# Machine-checked via assert(): a clean run exits 0; any failure prints "ASSERT FAILED: ..." and
# the process exits nonzero (see main.c/error.c).

# Plain scalars never even reach the chain2 check -- try_emit_binary_raw's own raw-arithmetic fast
# path claims them first (both operands are raw-composable int/real constants), same as it always
# has. Included to confirm this feature doesn't change ordinary scalar arithmetic at all.
x = (1 + 2) * 3
assert(x == 9, "plain int chain -- unaffected by this feature, raw arithmetic claims it first")

y = (1.5 + 2.5) * 2.0
assert(y == 8.0, "plain real chain -- same reasoning")

# The motivating shape: matching float32 typed arrays, fully fused.
a2 = [0.0f; 3]
a2[0] = 1.0
a2[1] = 1.0
a2[2] = 1.0
b2 = [0.0f; 3]
b2[0] = 1.0
b2[1] = 1.0
b2[2] = 1.0
half2 = [0.5f; 3]
e1 = (a2 + b2) * half2
assert(e1[0] == 1.0 and e1[1] == 1.0 and e1[2] == 1.0, "matching float32 typed arrays, fused path")

# float64 typed arrays -- the OTHER kind the fused kernels cover (typed_chain2_f64, vm.c).
a3 = [0.0; 3]
a3[0] = 2.0
a3[1] = 4.0
a3[2] = 6.0
b3 = [0.0; 3]
b3[0] = 1.0
b3[1] = 1.0
b3[2] = 1.0
c3 = [3.0; 3]
r3 = (a3 - b3) * c3
assert(r3[0] == 3.0 and r3[1] == 9.0 and r3[2] == 15.0, "matching float64 typed arrays, fused path")

# int32 typed arrays -- syntactically identical shape, but NOT in the fused kernel set (float32/
# float64 only) -- the parser can't know this at compile time (the shape is only checked at
# runtime, inside OP_TYPED_ARRAY_CHAIN2's own handler), so this still emits the fused opcode, which
# must then correctly fall back to computing the exact unfused result instead of misbehaving.
ai = [0i; 3]
ai[0] = 1
ai[1] = 2
ai[2] = 3
bi = [0i; 3]
bi[0] = 10
bi[1] = 20
bi[2] = 30
ci = [2i; 3]
ri = (ai + bi) * ci
assert(ri[0] == 22 and ri[1] == 44 and ri[2] == 66, "int32 typed arrays -- not in the fused kernel set, correct via runtime fallback")

# A different (op1, op2) combination than the benchmark's own (ADD, MUL) -- proves this isn't
# hardcoded to one specific operator pair.
f1 = [0.0f; 3]
f1[0] = 10.0
f1[1] = 20.0
f1[2] = 30.0
g1 = [0.0f; 3]
g1[0] = 1.0
g1[1] = 2.0
g1[2] = 3.0
h1 = [0.0f; 3]
h1[0] = 100.0
h1[1] = 100.0
h1[2] = 100.0
k1 = (f1 - g1) + h1
assert(k1[0] == 109.0 and k1[1] == 118.0 and k1[2] == 127.0, "SUB then ADD -- a different op1/op2 combination than the benchmark's own")

# Mismatched-length (and mismatched-elem_kind) typed arrays fall back to computing the exact
# unfused result, same as any other shape this fast path doesn't recognize -- vm_typed_array_
# binary_op's own length/elem_kind check runs identically either way, so a mismatch still raises
# the SAME clean error it always did, not a crash or silent out-of-bounds access. Can't be asserted
# inline (a real runtime error aborts the whole script, same "documented, not run inline"
# convention as every other error-path case in this suite, e.g. test_narrow_fields.aer) -- verified
# manually instead: `(m1 + n1) * q1` with m1/n1 different lengths raises "Typed arrays must have
# the same length", identical to the unfused `tmp = m1 + n1` alone.

print("test_typed_array_chain2.aer: all assertions passed.")
