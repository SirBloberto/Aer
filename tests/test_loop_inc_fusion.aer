#!/usr/bin/env aer
# AER test suite — the fused counter bump on a while-loop back-edge
# (OP_RAW_INC_LTE_INT_JUMP_IF_FALSE).
#
# `for i < n:` whose body ends in `i += step` folds both into one dispatch. Two things can go
# silently wrong: the trip count can shift by one, and a `continue` — which jumps to the back-edge
# — would run a bump the separate increment never reached. The fusion is declined when a loop
# contains `continue` for exactly that reason, so both halves need machine-checked coverage.

# ------------------------------------------------------------------ #
# 1. Trip count and final value, the shape that fuses.                #
# ------------------------------------------------------------------ #
n = 10
i = 0
trips = 0
for i < n:
    trips += 1
    i += 1
assert(trips == 10, "fused loop runs exactly n times")
assert(i == 10, "fused loop leaves the counter one past the last value")

# A step larger than one, landing exactly on the bound.
i = 0
trips = 0
for i < 10:
    trips += 1
    i += 2
assert(trips == 5, "step 2 to an exact bound runs n/step times")
assert(i == 10, "step 2 stops exactly on the bound")

# A step that overshoots the bound.
i = 0
trips = 0
for i < 10:
    trips += 1
    i += 3
assert(trips == 4, "step 3 overshooting the bound still stops")
assert(i == 12, "the counter keeps its overshot value")

# A loop whose condition is false on entry must not run at all.
i = 50
trips = 0
for i < 10:
    trips += 1
    i += 1
assert(trips == 0, "a loop false on entry never runs, fused or not")
assert(i == 50, "and never touches the counter")

# ------------------------------------------------------------------ #
# 2. `continue` declines the fusion — the bump must NOT run on that   #
#    path, so odd values are skipped and the total differs.           #
# ------------------------------------------------------------------ #
i = 0
seen = 0
guard = 0
for i < 10:
    guard += 1
    if guard > 100:
        i = 999
    if i % 2 == 0:
        i += 1
        continue
    seen += i
    i += 1
assert(seen == 25, "continue skips the accumulate: 1+3+5+7+9")
assert(i == 10, "continue path still advances the counter exactly once")

# ------------------------------------------------------------------ #
# 3. `break` leaves the counter where the body left it.               #
# ------------------------------------------------------------------ #
i = 0
trips = 0
for i < 100:
    trips += 1
    if i == 4:
        break
    i += 1
assert(trips == 5, "break exits on the iteration it fires")
assert(i == 4, "break does not run the bump it jumped over")

# ------------------------------------------------------------------ #
# 4. Nested fused loops keep their own counters.                      #
# ------------------------------------------------------------------ #
outer = 0
total = 0
for outer < 4:
    inner = 0
    for inner < 3:
        total += 1
        inner += 1
    assert(inner == 3, "inner counter completes every pass")
    outer += 1
assert(total == 12, "nested fused loops multiply their trip counts")
assert(outer == 4, "outer counter unaffected by the inner loop")

# ------------------------------------------------------------------ #
# 5. A bump inside a trailing `if` is conditional: it must not fuse.  #
# ------------------------------------------------------------------ #
i = 0
trips = 0
for i < 10:
    trips += 1
    if trips > 50:
        break
    if trips % 2 == 0:
        i += 1
assert(trips == 20, "a trailing if's bump runs only when its condition holds")
assert(i == 10, "and the loop still ends on the bound")

i = 0
trips = 0
for i < 10:
    trips += 1
    if trips % 2 == 0:
        i += 2
    else:
        i += 1
assert(trips == 7, "each branch of a trailing if/else runs its own bump")
assert(i == 10, "the else-branch bump is not run after the if-branch one")

print("loop increment fusion: all assertions passed")
