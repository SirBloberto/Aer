#!/usr/bin/env aer
# AER test suite — standard library (math, random, string, time),
# file-based imports, and the io module.
# Machine-checked via assert(): a clean run exits 0; any failure prints
# "ASSERT FAILED: ..." and the process exits nonzero (see main.c/error.c).

# ------------------------------------------------------------------ #
# 25. Standard library — math, sort, random                           #
# ------------------------------------------------------------------ #

import math
import random
import collection

assert(math.sqrt(16.0) == 4, "math.sqrt")
assert(math.pow(2, 10) == 1024, "math.pow")
assert(math.floor(3.7) == 3, "math.floor")
assert(math.ceil(3.2) == 4, "math.ceil")
assert(math.abs(-5) == 5, "math.abs on an integer")
assert(math.abs(-5.5) == 5.5, "math.abs on a float")
assert(math.min(3, 7) == 3, "math.min")
assert(math.max(3, 7) == 7, "math.max")

sorted_nums = collection.sort([5, 3, 8, 1, 9, 2])
assert(sorted_nums[0] == 1 and sorted_nums[1] == 2 and sorted_nums[5] == 9, "collection.sort on numbers, ascending")

sorted_words = collection.sort(["banana", "apple", "cherry"])
assert(sorted_words[0] == "apple" and sorted_words[1] == "banana" and sorted_words[2] == "cherry", "collection.sort on strings, lexicographic")

assert(math.sin(0) == 0, "math.sin(0)")
assert(math.cos(0) == 1, "math.cos(0)")
assert(math.log(1) == 0, "math.log(1) — natural log")
assert(math.log2(8) == 3, "math.log2(8)")
assert(math.log10(1000) == 3, "math.log10(1000)")
assert(math.round(2.5) == 3 and math.round(2.4) == 2, "math.round() rounds to nearest integer")
assert(math.round(-2.5) == -3, "math.round() rounds negative halves away from zero, not toward zero")
assert(math.tan(0) == 0, "math.tan(0)")
assert(math.exp(0) == 1, "math.exp(0)")
assert(math.exp(1) > 2.718 and math.exp(1) < 2.719, "math.exp(1) is e")
assert(math.pi() > 3.14 and math.pi() < 3.15, "math.pi() is a function, not a bare module value")

r = random.random()
assert(r >= 0.0 and r < 1.0, "random.random() is in [0, 1)")

ri = random.randint(1, 6)
assert(ri >= 1 and ri <= 6, "random.randint(1, 6) is in [1, 6]")

# random.seed() reseeds the RNG — the only way to prove it worked is that
# two sequences started from the same seed agree.
random.seed(42)
seeded_first = random.random()
random.seed(42)
seeded_second = random.random()
assert(seeded_first == seeded_second, "random.seed() makes subsequent random() calls reproducible")

# Wide spans — the old C-rand() implementation (RAND_MAX 32767 on MinGW) could never produce a
# value above min+32767 for a span this wide; 60 draws each miss the top half with p < 1e-7.
random.seed(7)
randint_saw_high = false
for wide_i in 0..60:
    if random.randint(1, 100000) > 50000:
        randint_saw_high = true
assert(randint_saw_high, "random.randint() reaches the full requested range, not just the bottom 32768 values")

choice_pool = [10, 20, 30]
chosen = random.choice(choice_pool)
assert(chosen == 10 or chosen == 20 or chosen == 30, "random.choice() returns one of the array's own elements")

shuffle_arr = [1, 2, 3, 4, 5, 6, 7, 8]
random.shuffle(shuffle_arr)
shuffle_sorted = collection.sort(collection.copy(shuffle_arr))
shuffle_ok = length(shuffle_arr) == 8
for shuffle_i in 0..8:
    if shuffle_sorted[shuffle_i] != shuffle_i + 1:
        shuffle_ok = false
assert(shuffle_ok, "random.shuffle() permutes in place — same elements, same length")

# sqrt(16.0) — error: stdlib functions require the module prefix once imported

import string

assert(string.upper("hello") == "HELLO", "string.upper")
assert("hello" |> string.upper() == "HELLO", "pipe operator can target a module-qualified function, not just a bare name")
assert(string.lower("HELLO") == "hello", "string.lower")
assert(string.trim("  padded  ") == "padded", "string.trim")
assert(string.contains("hello world", "wor"), "string.contains — match")
assert(not string.contains("hello world", "xyz"), "string.contains — no match")
assert(string.index_of("hello world", "wor") == 6, "string.index_of — position of the first match")
assert(string.index_of("hello world", "xyz") == -1, "string.index_of — -1 when absent")
assert(string.index_of("aXbXc", "X") == 1, "string.index_of — first of several matches")

split_result = string.split("a,b,c", ",")
assert(length(split_result) == 3 and split_result[0] == "a" and split_result[2] == "c", "string.split")
assert(string.join(["a", "b", "c"], "-") == "a-b-c", "string.join")

assert(string.starts_with("hello world", "hello"), "string.starts_with — match")
assert(not string.starts_with("hello world", "world"), "string.starts_with — no match")
assert(string.ends_with("hello world", "world"), "string.ends_with — match")
assert(not string.ends_with("hello world", "hello"), "string.ends_with — no match")
assert(string.repeat("ab", 3) == "ababab", "string.repeat")
assert(string.repeat("x", 0) == "", "string.repeat with count 0 is empty")
assert(string.replace("foo bar foo", "foo", "baz") == "baz bar baz", "string.replace — multiple matches")
assert(string.replace("aaa", "a", "bb") == "bbbbbb", "string.replace — replacement longer than the match")

# split/replace/find search for the next match rather than testing every position (aer_bytes_find,
# value.h). The boundaries are where a search rewrite goes wrong, so pin them: separators at the very
# start and end produce empty segments, adjacent separators produce empty segments between them, and
# a needle whose first byte matches but whose tail does not must not count as a hit.
edge = string.split(",a,,b,", ",")
assert(length(edge) == 5, "split: leading, adjacent and trailing separators all produce segments")
assert(edge[0] == "" and edge[1] == "a" and edge[2] == "" and edge[3] == "b" and edge[4] == "",
       "split: every one of those segments is in the right place")
assert(length(string.split("abc", ",")) == 1 and string.split("abc", ",")[0] == "abc",
       "split: no separator anywhere yields the whole string")
assert(length(string.split("", ",")) == 1 and string.split("", ",")[0] == "",
       "split: the empty string yields one empty segment")
assert(length(string.split("aXXb", "XX")) == 2 and string.split("aXXb", "XX")[1] == "b",
       "split: a multi-byte separator")
multi = string.split("aXbXXc", "XX")
assert(length(multi) == 2 and multi[0] == "aXb" and multi[1] == "c",
       "split: a lone first byte of a multi-byte separator is not a match")
assert(length(string.split("xxx", "x")) == 4, "split: every character being a separator")

assert(string.replace("aXbXXc", "XX", "-") == "aXb-c", "replace: partial first-byte match is not replaced")
assert(string.replace("abc", "z", "!") == "abc", "replace: no match leaves the string alone")
assert(string.replace("aaa", "aa", "b") == "ba", "replace: overlapping candidates consume left to right")
assert(string.replace("xay", "a", "") == "xy", "replace: an empty replacement deletes the match")
assert(string.index_of("aXbXXc", "XX") == 3, "index_of: skips a lone first byte and finds the real match")
assert(string.index_of("abc", "abcd") == -1, "index_of: a needle longer than the haystack is absent")
assert(string.index_of("abc", "c") == 2, "index_of: a match at the very last byte")
assert(not string.contains("aXb", "XX"), "contains: partial first-byte match is not a match")

import time

# Can't assert an exact value — sanity-check it's a plausible epoch second
# count (well past 2023-11-14, the value below) rather than 0 or negative.
assert(time.now() > 1700000000, "time.now() returns a plausible current epoch time")

# Sub-second precision — two calls close together should differ by less than
# a second (would always be exactly equal integers, or differ by whole
# seconds only, under the old time()-based implementation).
t_before = time.now()
spin = 0
for spin < 100000:
    spin += 1
t_after = time.now()
assert(t_after > t_before, "time.now() has sub-second precision — a short interval still shows forward progress")
assert(t_after - t_before < 5.0, "the same short interval measures as a small fraction of a second, not whole seconds")

# strftime — a fixed, known timestamp so the formatted result is deterministic
# regardless of when the test runs. 1700000000 is 2023-11-14 22:13:20 UTC;
# formatted in whatever the test machine's local timezone is, so only the
# parts that don't depend on timezone are asserted.
formatted = time.strftime(1700000000, "%Y")
assert(formatted == "2023", "time.strftime() formats a timestamp using a strftime-style format string")

sleep_before = time.now()
time.sleep(0.05)
sleep_after = time.now()
assert(sleep_after - sleep_before >= 0.04, "time.sleep() really waits at least (about) the requested interval")

# parse — the strptime side of strftime. Round-tripping through parse() then strftime() with the
# same format is timezone-independent by construction: parse()'s mktime() interprets the fields as
# local time, and strftime()'s localtime() decodes the resulting epoch back the same way, so
# whatever the test machine's timezone is, the round trip reproduces the original string exactly.
round_trip = time.strftime(time.parse("2024-01-15 13:45:30", "%Y-%m-%d %H:%M:%S"), "%Y-%m-%d %H:%M:%S")
assert(round_trip == "2024-01-15 13:45:30", "time.parse() followed by time.strftime() with the same format round-trips exactly")

date_only = time.strftime(time.parse("2024-01-15", "%Y-%m-%d"), "%Y-%m-%d")
assert(date_only == "2024-01-15", "time.parse() with a date-only format round-trips exactly")

# to_parts/from_parts — a fixed, known timestamp so the parts are deterministic regardless of
# timezone (only the calendar fields are asserted, not epoch/weekday, which shift with local tz).
known = time.parse("2024-03-15 09:30:45", "%Y-%m-%d %H:%M:%S")
parts = time.to_parts(known)
assert(parts["year"] == 2024, "time.to_parts() extracts the year")
assert(parts["month"] == 3, "time.to_parts() extracts the month (1-indexed)")
assert(parts["day"] == 15, "time.to_parts() extracts the day")
assert(parts["hour"] == 9, "time.to_parts() extracts the hour")
assert(parts["min"] == 30, "time.to_parts() extracts the minute")
assert(parts["sec"] == 45, "time.to_parts() extracts the second")

assert(time.from_parts(time.to_parts(known)) == known, "from_parts(to_parts(x)) round-trips to the same epoch")

# Calendar arithmetic falls out of to_parts/from_parts for free: mktime() normalizes an
# out-of-range day, so adding days doesn't need any dedicated add/subtract logic.
tomorrow_parts = time.to_parts(known)
tomorrow_parts["day"] = tomorrow_parts["day"] + 1
assert(time.strftime(time.from_parts(tomorrow_parts), "%Y-%m-%d") == "2024-03-16", "adding 1 to the day field and calling from_parts() advances the date by a day")

month_rollover = time.to_parts(time.parse("2024-01-31", "%Y-%m-%d"))
month_rollover["day"] = month_rollover["day"] + 1
assert(time.strftime(time.from_parts(month_rollover), "%Y-%m-%d") == "2024-02-01", "adding a day past a month's end rolls over into the next month via mktime()'s own normalization")

# ------------------------------------------------------------------ #
# 26. File-based imports                                              #
# ------------------------------------------------------------------ #

# helpers.aer sits alongside this file and defines double(n), greet(name),
# and add(a, b). import resolves it relative to this file's own directory,
# runs it once (synchronously, at parse time), and its functions become
# reachable as helpers.<name>(...) — call-only, same as the native modules.
import helpers

assert(helpers.double(21) == 42, "file-based import — function call")
assert(helpers.greet("AER") == "Hello, AER!", "file-based import — string-returning function")
assert(helpers.add(2, 3) == 5, "file-based import — a second function from the same module")

# A defaulted trailing parameter works the same across a module-call boundary
# (aer_module_call -> vm_setup_call) as it does for a same-VM call.
assert(helpers.scale(5) == 10, "cross-module call — default parameter applies")
assert(helpers.scale(5, 3) == 15, "cross-module call — explicit argument overrides the default, not padded with it too")

# A second `import helpers` is a harmless no-op, not a re-run:
import helpers
assert(helpers.double(10) == 20, "re-importing the same file is a no-op, not a second execution")

# A dotted import path is a directory hint only ("sub.greet" -> "sub/greet.aer")
# — the module still binds under its own bare name, "greet".
import sub.greet
assert(greet.hello("AER") == "hello from sub/greet, AER", "dotted import — import sub.greet resolves sub/greet.aer and binds as 'greet'")

# 9 distinct file imports — one past the module system's old hardcoded
# 8-file cap (aer_module.c's MAX_FILE_MODULES, the lexer's own open-file
# table, and Chunk's imported_modules array all used to cap at 8).
import manyimports.mod1
import manyimports.mod2
import manyimports.mod3
import manyimports.mod4
import manyimports.mod5
import manyimports.mod6
import manyimports.mod7
import manyimports.mod8
import manyimports.mod9
many_total = (mod1.val1() + mod2.val2() + mod3.val3() + mod4.val4() + mod5.val5() +
              mod6.val6() + mod7.val7() + mod8.val8() + mod9.val9())
assert(many_total == 45, "9 distinct file imports all work, past the old 8-file cap")

# ------------------------------------------------------------------ #
# 30. File I/O — io module (host-registered, not a native module)     #
# ------------------------------------------------------------------ #

# io is granted by the CLI host (source/main.c calls aer_io_register()),
# not baked into the parser's native-module table like math/random/string —
# see the README's "File I/O" section. tests/embed_smoke_test.c proves the
# opposite case (a host that never registers it has no file access at all).
import io

scratch_path = "tests/io_scratch.txt"

write_result, write_err = io.write(scratch_path, "hello from AER\nsecond line")
assert(write_err == null, "io.write() succeeds and returns no error")

contents, read_err = io.read(scratch_path)
assert(read_err == null and contents == "hello from AER\nsecond line",
       "io.read() returns exactly what was written")

missing_contents, missing_err = io.read("tests/definitely_does_not_exist.txt")
assert(missing_contents == null and missing_err != null,
       "io.read() on a nonexistent file returns a null value and a non-null error")

append_result, append_err = io.append(scratch_path, "\nthird line")
assert(append_err == null, "io.append() succeeds and returns no error")
appended_contents, appended_read_err = io.read(scratch_path)
assert(appended_read_err == null and appended_contents == "hello from AER\nsecond line\nthird line",
       "io.append() adds to the end of an existing file rather than truncating it")

assert(io.exists(scratch_path), "io.exists() is true for a file that was just written")
assert(not io.exists("tests/definitely_does_not_exist.txt"), "io.exists() is false for a missing path — an answer, not an error")

remove_result, remove_err = io.remove(scratch_path)
assert(remove_err == null, "io.remove() deletes an existing file without error")
assert(not io.exists(scratch_path), "the removed file is really gone")
missing_remove, missing_remove_err = io.remove(scratch_path)
assert(missing_remove_err != null, "io.remove() on a now-missing path reports an error through the Result, not an abort")

# The test suite runs scripts with no extra CLI arguments, so args() is empty here; the CLI
# passes everything after the script path through (see main.c).
assert(length(io.args()) == 0, "io.args() with no script arguments is an empty array")

# Path utilities — pure string manipulation, no filesystem access; handle both '/' and '\' since
# io.args() can hand back an OS-native path on Windows.
assert(io.basename("a/b/c.txt") == "c.txt", "io.basename() returns the substring after the last separator")
assert(io.basename("a\\b\\c.txt") == "c.txt", "io.basename() also recognizes a backslash separator")
assert(io.basename("c.txt") == "c.txt", "io.basename() with no separator returns the whole string")
assert(io.dirname("a/b/c.txt") == "a/b", "io.dirname() returns everything before the last separator")
assert(io.dirname("c.txt") == ".", "io.dirname() with no separator returns '.', matching POSIX dirname")
assert(io.dirname("/etc") == "/", "io.dirname() of a top-level path returns '/', not an empty string")
assert(io.join("a/b", "c.txt") == "a/b/c.txt", "io.join() inserts exactly one separator")
assert(io.join("a/b/", "c.txt") == "a/b/c.txt", "io.join() doesn't double a separator already present")

# ------------------------------------------------------------------ #
# json — encode/decode (a native module, same dispatch as math/string) #
# ------------------------------------------------------------------ #

import json

assert(json.encode(null) == "null", "json.encode(null)")
assert(json.encode(true) == "true", "json.encode(true)")
assert(json.encode(42) == "42", "json.encode() on an integer")
assert(json.encode("hi") == "\"hi\"", "json.encode() on a plain string")

# A whole-number float must round-trip as a float, not silently become an integer: json.encode()
# always shows a decimal point, and json.decode()'s number parser recognizes a token as a float
# only if it contains '.'/'e'.
assert(json.encode(5.0) == "5.0", "json.encode() on a whole-number float keeps its decimal point")
whole_float_json = json.encode({"price": 5.0})
decoded_price, price_err = json.decode(whole_float_json)
assert(price_err == null and type(decoded_price["price"]) == "float" and decoded_price["price"] == 5.0,
       "json.encode()/decode() round-trips a whole-number float as a float, not an integer")

arr_json = json.encode([1, 2, "three", true, null])
assert(arr_json == "[1,2,\"three\",true,null]", "json.encode() on a mixed array")

decoded_arr, arr_err = json.decode(arr_json)
assert(arr_err == null, "json.decode() on a well-formed array has no error")
assert(decoded_arr[0] == 1 and decoded_arr[2] == "three" and decoded_arr[3] == true and decoded_arr[4] == null,
       "json.decode() round-trips a mixed array exactly")

dict_json = json.encode({"a": 1})
decoded_dict, dict_err = json.decode(dict_json)
assert(dict_err == null and decoded_dict["a"] == 1, "json.encode()/decode() round-trips a plain hashtable as a JSON object")

# A struct instance encodes as a JSON object keyed by its field names, not
# as a bare positional array — the distinction called out in the plan: a
# struct is structurally a hashtable on the wire, so it decodes back as one
# (AER has no way to know which struct type a plain JSON object came from).
struct JsonPoint:
    x = 0
    y = 0

point = JsonPoint(3, 4)
point_json = json.encode(point)
assert(point_json == "\{\"x\":3,\"y\":4}", "json.encode() encodes a struct instance as a JSON object using its field names")

decoded_point, point_err = json.decode(point_json)
assert(point_err == null and decoded_point["x"] == 3 and decoded_point["y"] == 4,
       "json.decode() reads a struct-shaped JSON object back as a plain hashtable")

# Escaping — quotes, backslashes, and control characters all round-trip.
escaped = json.encode("line1\nline2\t\"quoted\"")
decoded_str, str_err = json.decode(escaped)
assert(str_err == null and decoded_str == "line1\nline2\t\"quoted\"", "json.encode()/decode() round-trips escaped characters exactly")

# Malformed input reports an error instead of aborting the script, matching
# every other fallible stdlib function's (value, err) convention.
bad_value, bad_err = json.decode("[1, 2,")
assert(bad_value == null and bad_err != null, "json.decode() on malformed input returns (null, error) rather than crashing")

print("test_stdlib_modules.aer: all assertions passed.")
