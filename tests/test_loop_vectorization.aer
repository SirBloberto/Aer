# A range-for that only accumulates over one array is rewritten into a single whole-array reduction
# (try_vectorize_reduction, parser.c). Most of what matters here is the shapes it must DECLINE: the
# rewrite is invisible, so a case it wrongly accepts produces a wrong number rather than a crash.

a = [0i; 8]
ai = 0
for ai < 8:
    a[ai] = ai * ai
    ai += 1
n = length(a)
# a is [0, 1, 4, 9, 16, 25, 36, 49]; the elements sum to 140.

# --- shapes it rewrites ---
t = 0
for i in 0..n:
    t = t + a[i]
assert(t == 140, "vectorized sum over a typed int array")

t = 0
for i in 0..n:
    t = t + a[i] * 2
assert(t == 280, "vectorized sum of a scaled element")

# The const-operand arithmetic forms (OP_RAW_ADD_INT_K / _SUB_INT_K) carry their constant as an
# index into the chunk's raw-int table rather than as a register, so they need reading back.
t = 0
for i in 0..n:
    t = t + (a[i] + 5)
assert(t == 180, "vectorized sum with a constant added per element")

t = 0
for i in 0..n:
    t = t + (a[i] - 1) * 3
assert(t == 396, "vectorized sum of a nested constant expression")

# Without the parentheses this is `(t + a[i]) - 1`, which subtracts once per iteration rather than
# once per element -- not one sum, and correctly left as a loop.
t = 0
for i in 0..n:
    t = t + a[i] - 1
assert(t == 132, "a constant applied to the accumulator, not the element, stays a loop")

# A second column joins in only once its length is known to match. Both being built from one count
# value proves it; nothing else does.
b = [0i; 8]
bi = 0
for bi < 8:
    b[bi] = bi * 2
    bi += 1

t = 0
for i in 0..n:
    t = t + a[i] * b[i]
assert(t == 1568, "vectorized dot product over two columns of proven-equal length")

t = 0
for i in 0..n:
    t = t + (a[i] + b[i]) * 2
assert(t == 392, "vectorized sum over an expression in two columns")

# Different count values, so the lengths are not known to match and the loop stands.
short_n = 4
long_n = 9
p = [2i; short_n]
q = [3i; long_n]
t = 0
for i in 0..length(p):
    t = t + p[i] * q[i]
assert(t == 24, "columns of different length are not folded together")

# Same count VARIABLE, but written in between, so the two lengths are unrelated.
k = 4
r = [2i; k]
k = 9
s = [3i; k]
t = 0
for i in 0..length(r):
    t = t + r[i] * s[i]
assert(t == 24, "a count reassigned between constructions does not prove equal length")

# --- shapes it must decline, each still producing the loop's own answer ---
t = 0
for i in 0..n:
    t = t + a[i]
    t = t + 1
assert(t == 148, "a second statement in the body is not vectorized")

t = 0
for i in 0..n:
    if a[i] > 4:
        t = t + a[i]
assert(t == 135, "a branch in the body is not vectorized")

t = 0
for i in 0..n:
    t = t + a[0]
assert(t == 0, "indexing by something other than the loop variable is not vectorized")

t = 0
for i in 0..n:
    if i > 3:
        break
    t = t + a[i]
assert(t == 14, "a break in the body is not vectorized")

t = 0
for i in 0..4:
    t = t + a[i]
assert(t == 14, "a bound that is not the array's length is not vectorized")

# The running total is itself an operand, so no single pass over the array can reproduce it.
t = 0
for i in 0..n:
    t = t + a[i] + t
assert(t == 685, "an accumulator read inside the expression is not vectorized")

t = 0
for i in 0..n:
    t = t + a[i] * a[i]
assert(t == 4676, "two array operands are not vectorized in this phase")

# The loop variable outliving the loop still has to hold what the loop left in it.
last = -1
t = 0
for i in 0..n:
    t = t + a[i]
    last = i
assert(last == 7 and t == 140, "a body that also writes another variable is not vectorized")

# The reduction covers the whole array, so a loop over only part of it must not be rewritten. This
# is the case that got through review: `for j in (i * i)..n` summed the entire array instead.
t = 0
for i in 2..n:
    t = t + a[i]
assert(t == 139, "a range that does not start at zero is not vectorized")

t = 0
start = 3
for i in start..n:
    t = t + a[i]
assert(t == 135, "a variable start is not vectorized")

t = 0
for i in 0..n..2:
    t = t + a[i]
assert(t == 56, "a step other than one is not vectorized")

# An empty range contributes nothing, exactly as the loop would.
empty = [0i; 0]
t = 99
for i in 0..length(empty):
    t = t + empty[i]
assert(t == 99, "an empty range adds nothing")

# Float accumulators vectorize too. collection.sum keeps four partial sums rather than one running
# total, which reassociates -- measured MORE accurate than sequential addition, not less, but not
# bit-for-bit what the loop produced.
f = [1.5; 4]
ft = 0.0
for i in 0..length(f):
    ft = ft + f[i]
assert(ft == 6.0, "vectorized sum over a float array")

fa = [0.0; 6]
fb = [0.0; 6]
fi = 0
for fi < 6:
    fa[fi] = float(fi)
    fb[fi] = float(fi) * 2.0
    fi += 1
fn = length(fa)

ft = 0.0
for i in 0..fn:
    ft = ft + fa[i] * fb[i]
assert(ft == 110.0, "vectorized float dot product")

# Several independent accumulators in one body are several reductions, not one.
ax = 0.0
ay = 0.0
az = 0.0
for i in 0..fn:
    ax = ax + fa[i]
    ay = ay + fb[i]
    az = az + fa[i] * fb[i]
assert(ax == 15.0 and ay == 30.0 and az == 110.0, "three accumulators in one body all vectorize")

# Mixing an accumulator into another statement's arithmetic still has to decline.
bx = 0
by = 0
for i in 0..n:
    bx = bx + a[i]
    by = by + bx
assert(bx == 140 and by == 336, "an accumulator read by a second statement is not vectorized")

print("test_loop_vectorization.aer: all assertions passed.")
