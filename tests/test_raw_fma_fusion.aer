#!/usr/bin/env aer
# AER test suite — raw-real fused multiply-accumulate superinstruction (OP_RAW_FMA_REAL/
# OP_RAW_FMS_REAL, vm.c; the compound-assignment parser's own fusion detection, parser.c).
# `x += a*b` / `x -= a*b` on raw real locals collapses the RHS's own just-emitted OP_RAW_MUL_REAL
# and this op's ADD/SUB into ONE dispatch, still computing the exact same two-rounding result as
# the unfused form (not a hardware single-rounding FMA) -- every result here must match exactly
# what the unfused two-statement form would have produced.
# Machine-checked via assert(): a clean run exits 0; any failure prints "ASSERT FAILED: ..." and
# the process exits nonzero (see main.c/error.c).

# The motivating shape: `x -= a*b` / `x += a*b` on raw real locals, fused.
a = 2.0
b = 3.0
x = 10.0
x -= a * b
assert(x == 4.0, "x -= a*b on raw real locals -- fused path")

y = 1.0
y += a * b
assert(y == 7.0, "x += a*b on raw real locals -- fused path")

# Repeated in a loop (nbody.aer's own shape) -- proves it's stable across many iterations, not
# just a one-shot check.
i = 0
acc = 0.0
p = 2.0
q = 3.0
for i < 1000:
    acc += p * q
    i += 1
assert(acc == 6000.0, "x += a*b repeated 1000 times in a loop")

j = 0
acc2 = 10000.0
for j < 1000:
    acc2 -= p * q
    j += 1
assert(acc2 == 4000.0, "x -= a*b repeated 1000 times in a loop")

# `x *= a*b` is NOT a fusable shape (only ADD/SUB are) -- must still compute correctly via the
# ordinary unfused path.
m = 2.0
m *= a * b
assert(m == 12.0, "x *= a*b -- not fused, still correct")

# A RHS that is NOT a bare `a*b` (an extra term) must not be mistaken for the fusable shape.
n = 10.0
n -= a * b + 1.0
assert(n == 3.0, "x -= a*b + c -- more than one op on the RHS, not fused, still correct")

# Reusing an ALREADY-COMPUTED raw value as the RHS (no fresh MUL emitted for this statement at
# all) must not be mistaken for the fusable shape either.
precomputed = a * b
o = 10.0
o -= precomputed
assert(o == 4.0, "x -= <already-computed raw value> -- no fresh MUL this statement, not fused, still correct")

# Integer compound assignment with the same `x -= a*b` shape stays on the existing (non-fused,
# int-only) path -- OP_RAW_FMA_REAL/FMS_REAL are real-only.
ia = 2
ib = 3
ix = 10
ix -= ia * ib
assert(ix == 4, "integer x -= a*b -- real-only fusion must not misfire on ints")

print("test_raw_fma_fusion.aer: all assertions passed.")
