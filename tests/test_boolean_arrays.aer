import collection

flags = [false; 5]
assert(type(flags) == "boolean[]", "a boolean fill builds a boolean[]")
assert(length(flags) == 5, "length of a boolean[]")
assert(flags[0] == false, "elements start as the fill")
flags[2] = true
flags[4] = true
assert(flags[2] and not flags[3], "a stored true reads back true and its neighbour stays false")

on = [true; 3]
assert(on[1], "a true fill")

count = 0
for f in flags:
    if f:
        count += 1
assert(count == 2, "iterating a boolean[] yields its booleans")

n = length(flags)
seen = 0
for i in 0..n:
    if flags[i]:
        seen += 1
assert(seen == 2, "a loop-proven index into a boolean[]")

assert(collection.sum(flags) == 2, "sum() counts the true elements")
assert(collection.sum([false; 0]) == 0, "sum() of an empty boolean[] is 0")
assert(collection.index_of(flags, true) == 2, "index_of finds the first true")
assert(collection.index_of(on, false) == -1, "index_of reports a missing boolean")
assert(collection.index_of(flags, 1) == -1, "a number is never found in a boolean[]")

copied = collection.copy(flags)
copied[0] = true
assert(copied[0] and not flags[0], "copy() is independent of the original")

part = flags[2:5]
assert(type(part) == "boolean[]", "a slice of a boolean[] is a boolean[]")
assert(length(part) == 3 and part[0] and not part[1], "a slice keeps its elements")

print("test_boolean_arrays: ok")
