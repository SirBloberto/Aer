#!/usr/bin/env aer
# AER test suite — the raw (unboxed) comparison and raw-vs-boxed arithmetic opcode families.
#
# Every one of these opcodes is emitted by a real parser path, but the `>`, `>=` and `<=` halves
# had no coverage: benchmarks and tests overwhelmingly write `<`, so OP_RAW_GT_REAL,
# OP_RAW_GTE_REAL, OP_RAW_LTE_REAL, their _BOXED forms, and the fused
# OP_RAW_GT/GTE_INT_BOXED_JUMP_IF_FALSE branch variants were never exercised. The same held for
# OP_RAW_SUB_INT_BOXED and OP_RAW_MUL_INT_BOXED (`-=`/`*=` of a boxed value into a raw int slot).
# These skip the boxing step and compare/accumulate raw slot contents directly, so a defect is a
# silently wrong answer rather than a crash. Machine-checked via assert().

# ------------------------------------------------------------------ #
# 1. Raw real comparisons: all four relational operators, both        #
#    orders, including the equal case each one straddles.             #
# ------------------------------------------------------------------ #

function real_ops(a, b):
    gt = 0
    gte = 0
    lt = 0
    lte = 0
    if a > b:
        gt = 1
    if a >= b:
        gte = 1
    if a < b:
        lt = 1
    if a <= b:
        lte = 1
    return [gt, gte, lt, lte]

r = real_ops(2.5, 1.5)
assert(r[0] == 1 and r[1] == 1 and r[2] == 0 and r[3] == 0, "raw real 2.5 vs 1.5: greater, not less")
r = real_ops(1.5, 2.5)
assert(r[0] == 0 and r[1] == 0 and r[2] == 1 and r[3] == 1, "raw real 1.5 vs 2.5: less, not greater")
r = real_ops(2.0, 2.0)
assert(r[0] == 0 and r[1] == 1 and r[2] == 0 and r[3] == 1, "raw real equal case: >= and <= hold, > and < do not")

# Negative and zero operands through the same paths.
r = real_ops(-1.5, -3.0)
assert(r[0] == 1 and r[3] == 0, "raw real comparison with both operands negative")
r = real_ops(0.0, -0.0)
assert(r[1] == 1 and r[3] == 1, "raw real 0.0 vs -0.0 compares equal in both directions")

# ------------------------------------------------------------------ #
# 2. Raw int comparisons against a boxed operand, used as a bare       #
#    if/while condition so the compare fuses with its branch.          #
# ------------------------------------------------------------------ #

# `n` must be initialised from a literal to earn a raw slot -- initialising it from a parameter
# makes it an ordinary boxed local, and none of these opcodes would be emitted at all.

function count_down_gt(floor_value):
    n = 10
    steps = 0
    for n > floor_value:
        n -= 1
        steps += 1
    return steps

assert(count_down_gt(4) == 6, "raw int `>` boxed as a loop condition counts down to the bound exclusively")
assert(count_down_gt(10) == 0, "raw int `>` loop does not run when already at the bound")

function count_down_gte(floor_value):
    n = 10
    steps = 0
    for n >= floor_value:
        n -= 1
        steps += 1
    return steps

assert(count_down_gte(4) == 7, "raw int `>=` boxed as a loop condition includes the bound")
assert(count_down_gte(10) == 1, "raw int `>=` loop runs exactly once when starting at the bound")

function count_up_lte(ceiling):
    n = 1
    steps = 0
    for n <= ceiling:
        n += 1
        steps += 1
    return steps

assert(count_up_lte(5) == 5, "raw int `<=` boxed as a loop condition includes the bound")
assert(count_up_lte(1) == 1, "raw int `<=` loop runs once when starting at the bound")

function compare_only(limit):
    n = 7
    a = 0
    if n > limit:
        a = 1
    if n >= limit:
        a += 10
    if n < limit:
        a += 100
    return a

assert(compare_only(3) == 11, "raw int vs boxed in value position: greater and greater-or-equal")
assert(compare_only(7) == 10, "raw int vs boxed at equality: only greater-or-equal holds")
assert(compare_only(9) == 100, "raw int vs boxed when less than the boxed operand")

# ------------------------------------------------------------------ #
# 3. Raw real compared against a boxed value (the _BOXED forms), and   #
#    the same comparisons in a non-branch (value-producing) position.  #
# ------------------------------------------------------------------ #

function real_vs_boxed(x, items):
    over = 0
    under = 0
    for i in 0..length(items):
        if x >= items[i]:
            over += 1
        if x <= items[i]:
            under += 1
    return [over, under]

vals = [1.0, 2.0, 3.0, 4.0]
r = real_vs_boxed(2.0, vals)
assert(r[0] == 2, "raw real >= boxed array element: 2.0 is >= 1.0 and 2.0")
assert(r[1] == 3, "raw real <= boxed array element: 2.0 is <= 2.0, 3.0 and 4.0")

flag = 2.5 > 1.5
assert(flag == true, "a raw real comparison in value position yields a boolean, not a branch")
flag2 = 1.5 >= 2.5
assert(flag2 == false, "the false case of a value-position raw real comparison")

# ------------------------------------------------------------------ #
# 4. Raw int slots accumulating a BOXED right-hand side via -= and *=. #
# ------------------------------------------------------------------ #

function shrink(items):
    acc = 100
    for i in 0..length(items):
        acc -= items[i]
    return acc

assert(shrink([1, 2, 3, 4]) == 90, "raw int -= boxed array element across every element")
assert(shrink([5, -5]) == 100, "raw int -= with a negative boxed operand cancels out")

function scale(items):
    acc = 1
    for i in 0..length(items):
        acc *= items[i]
    return acc

assert(scale([2, 3, 4]) == 24, "raw int *= boxed array element across every element")
assert(scale([-1, 3]) == -3, "raw int *= with a negative boxed operand keeps the sign")

# Mixed with the addition form, which already had coverage -- confirms the three share a slot
# correctly rather than each writing somewhere different.
function mixed(items):
    acc = 10
    for i in 0..length(items):
        acc += items[i]
        acc -= 1
        acc *= 2
    return acc

assert(mixed([1]) == 20, "add, subtract and multiply against boxed operands compose in one raw slot")
assert(mixed([1, 0]) == 38, "and keep composing across iterations")

# ------------------------------------------------------------------ #
# 5. The same comparisons in VALUE position rather than as a bare      #
#    condition -- a bare condition fuses into a branch opcode, so this #
#    is the only way to reach the standalone compare forms.            #
# ------------------------------------------------------------------ #

function raw_vs_boxed_values(limit):
    n = 7
    is_gt = n > limit
    is_gte = n >= limit
    is_lt = n < limit
    is_lte = n <= limit
    return [is_gt, is_gte, is_lt, is_lte]

v = raw_vs_boxed_values(3)
assert(v[0] == true and v[1] == true and v[2] == false and v[3] == false, "raw int vs boxed, value position, greater")
v = raw_vs_boxed_values(7)
assert(v[0] == false and v[1] == true and v[2] == false and v[3] == true, "raw int vs boxed, value position, equal")
v = raw_vs_boxed_values(9)
assert(v[0] == false and v[1] == false and v[2] == true and v[3] == true, "raw int vs boxed, value position, less")

function raw_real_pair():
    a = 2.5
    b = 4.0
    return [a < b, a <= b, a > b, a >= b, b <= a]

w = raw_real_pair()
assert(w[0] == true and w[1] == true, "two raw real locals: less-than and less-or-equal")
assert(w[2] == false and w[3] == false, "two raw real locals: greater comparisons are false")
assert(w[4] == false, "two raw real locals compared in the reverse order")

function raw_real_vs_boxed(bound):
    a = 2.5
    return [a >= bound, a <= bound]

x = raw_real_vs_boxed(2.5)
assert(x[0] == true and x[1] == true, "raw real vs boxed at equality: both >= and <= hold")
x = raw_real_vs_boxed(9.0)
assert(x[0] == false and x[1] == true, "raw real vs boxed below the bound")

# ------------------------------------------------------------------ #
# 6. A raw REAL local compared against a boxed value as a bare loop or  #
#    if condition, so the compare fuses with its branch. The compare is #
#    the LAST instruction of the condition rather than the whole of it, #
#    which is the shape `x * x + y * y > 4.0` takes.                    #
# ------------------------------------------------------------------ #

function count_down_real_gt(floor_value):
    rx = 10.0
    steps = 0
    for rx > floor_value:
        rx -= 1.0
        steps += 1
    return steps

assert(count_down_real_gt(4.0) == 6, "raw real `>` boxed as a loop condition")
assert(count_down_real_gt(10.0) == 0, "raw real `>` loop does not run when already at the bound")

function count_down_real_gte(floor_value):
    rx = 10.0
    steps = 0
    for rx >= floor_value:
        rx -= 1.0
        steps += 1
    return steps

assert(count_down_real_gte(4.0) == 7, "raw real `>=` boxed as a loop condition includes the bound")

function count_up_real_lt(ceiling):
    rx = 1.0
    steps = 0
    for rx < ceiling:
        rx += 1.0
        steps += 1
    return steps

assert(count_up_real_lt(5.0) == 4, "raw real `<` boxed as a loop condition")

function count_up_real_lte(ceiling):
    rx = 1.0
    steps = 0
    for rx <= ceiling:
        rx += 1.0
        steps += 1
    return steps

assert(count_up_real_lte(5.0) == 5, "raw real `<=` boxed as a loop condition includes the bound")

# The compare preceded by arithmetic -- the case the fusion used to miss because the condition was
# more than one instruction long.
function escape_steps(limit):
    ex = 0.25
    ey = 0.25
    steps = 0
    for ex * ex + ey * ey < limit:
        ex += 0.25
        ey += 0.25
        steps += 1
    return steps

assert(escape_steps(100.0) == 28, "a compare at the end of a longer condition still fuses and is correct")
assert(escape_steps(0.1) == 0, "and is false immediately when it should be")

# ------------------------------------------------------------------ #
# 7. A raw slot compared against a LITERAL bound. The literal is a     #
#    constant-pool operand rather than a register, so a wrong RK8      #
#    decode reads the wrong pool entry and silently compares against   #
#    some unrelated constant -- hence both operand orders and the      #
#    equality case each operator straddles.                            #
# ------------------------------------------------------------------ #

function count_up_real_lt_literal():
    rx = 1.0
    steps = 0
    for rx < 5.0:
        rx += 1.0
        steps += 1
    return steps

function count_up_real_lte_literal():
    rx = 1.0
    steps = 0
    for rx <= 5.0:
        rx += 1.0
        steps += 1
    return steps

function count_down_real_gt_literal():
    rx = 10.0
    steps = 0
    for rx > 4.0:
        rx -= 1.0
        steps += 1
    return steps

function count_down_real_gte_literal():
    rx = 10.0
    steps = 0
    for rx >= 4.0:
        rx -= 1.0
        steps += 1
    return steps

assert(count_up_real_lt_literal() == 4, "raw real `<` a literal bound as a loop condition")
assert(count_up_real_lte_literal() == 5, "raw real `<=` a literal bound includes the bound")
assert(count_down_real_gt_literal() == 6, "raw real `>` a literal bound as a loop condition")
assert(count_down_real_gte_literal() == 7, "raw real `>=` a literal bound includes the bound")

# The literal on the LEFT -- the parser flips the operator and swaps the operands.
function count_up_literal_gt_real():
    rx = 1.0
    steps = 0
    for 5.0 > rx:
        rx += 1.0
        steps += 1
    return steps

function count_up_literal_gte_real():
    rx = 1.0
    steps = 0
    for 5.0 >= rx:
        rx += 1.0
        steps += 1
    return steps

assert(count_up_literal_gt_real() == 4, "literal `>` raw real flips to the same loop as raw `<` literal")
assert(count_up_literal_gte_real() == 5, "literal `>=` raw real flips to the same loop as raw `<=` literal")

function count_down_int_gt_literal():
    n = 10
    steps = 0
    for n > 4:
        n -= 1
        steps += 1
    return steps

function count_up_int_lte_literal():
    n = 1
    steps = 0
    for n <= 5:
        n += 1
        steps += 1
    return steps

function count_down_literal_lt_int():
    n = 10
    steps = 0
    for 4 < n:
        n -= 1
        steps += 1
    return steps

assert(count_down_int_gt_literal() == 6, "raw int `>` a literal bound as a loop condition")
assert(count_up_int_lte_literal() == 5, "raw int `<=` a literal bound includes the bound")
assert(count_down_literal_lt_int() == 6, "literal `<` raw int flips to the same loop as raw `>` literal")

# Value position rather than a bare condition, which reaches the unfused compare opcodes.
function real_literal_values():
    rx = 2.5
    return [rx > 4.0, rx >= 4.0, rx < 4.0, rx <= 4.0, 4.0 > rx, 4.0 <= rx]

y = real_literal_values()
assert(y[0] == false and y[1] == false, "raw real 2.5 is neither > nor >= the literal 4.0")
assert(y[2] == true and y[3] == true, "raw real 2.5 is both < and <= the literal 4.0")
assert(y[4] == true and y[5] == false, "the same comparisons with the literal on the left")

function real_literal_at_bound():
    rx = 4.0
    return [rx > 4.0, rx >= 4.0, rx < 4.0, rx <= 4.0]

z = real_literal_at_bound()
assert(z[0] == false and z[1] == true, "raw real exactly at a literal bound: >= holds, > does not")
assert(z[2] == false and z[3] == true, "raw real exactly at a literal bound: <= holds, < does not")

function int_literal_values():
    n = 7
    return [n > 7, n >= 7, n < 7, n <= 7, 7 < n]

q = int_literal_values()
assert(q[0] == false and q[1] == true, "raw int exactly at a literal bound: >= holds, > does not")
assert(q[2] == false and q[3] == true and q[4] == false, "raw int exactly at a literal bound, remaining operators")

# A negative literal, which is a distinct pool entry from its positive twin.
function negative_literal_bound():
    rx = -2.5
    n = -3
    return [rx > -4.0, rx < -1.0, n >= -3, n < -3]

nb = negative_literal_bound()
assert(nb[0] == true and nb[1] == true, "raw real against negative literal bounds on both sides")
assert(nb[2] == true and nb[3] == false, "raw int against a negative literal bound at equality")

# A comparison kept as a VALUE rather than branched on: an `if` fuses its comparison into the
# branch, so this is the only shape that still emits the standalone raw-real forms.
function raw_real_compare_values():
    a = 1.5
    b = 2.5
    ne = a != b
    eq = a == b
    lt = a < b
    return [ne, eq, lt]

rrv = raw_real_compare_values()
assert(rrv[0] == true, "raw real != as a value")
assert(rrv[1] == false, "raw real == as a value")
assert(rrv[2] == true, "raw real < as a value")

print("test_raw_comparisons.aer: all assertions passed.")
