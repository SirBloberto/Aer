import actor

function add(a, b):
    return a + b

# actor.keep/actor.kept: the one value this actor holds between calls. A function cannot reach a
# top-level variable, so this is the only place an actor can put something it wants to reuse --
# without it, work that revisits the same data has to be handed it again on every call.
function stash(v):
    actor.keep(v)
    return length(actor.kept())

function stash_sum():
    d = actor.kept()
    n = length(d)
    s = 0.0
    i = 0
    for i < n:
        s = s + d[i]
        i += 1
    return s

function stash_is_null():
    return actor.kept() == null

function crash():
    return 1 / 0

# Heavy, GC-pressure-inducing allocation (throwaway arrays/strings every iteration, only the
# running total survives) -- used to prove two actors spawned from this same script, each running
# this independently, never corrupt each other's result (each actor now has its own heap).
function sum_range(n):
    total = 0
    i = 0
    for i < n:
        temp = [i, i * 2, "item_{i}"]
        total += temp[0] + temp[1]
        i += 1
    return total
