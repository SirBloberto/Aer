#!/usr/bin/env aer
# AER test suite — loops whose bound is an integer literal.
#
# `for i < K:` rotates like any other loop: the back-edge reads K from a preheader slot, because the
# complemented test wants K on the left where only a slot fits. Every case checks the trip count or
# the arithmetic, so a wrong slot or a wrong complement shows up as a wrong number, not a hang.

function count_to_literal():
    n = 0
    i = 0
    for i < 7:
        n += i
        i += 1
    return n

assert(count_to_literal() == 21, "0+1+...+6")

function zero_trip():
    n = 0
    i = 0
    for i < 0:
        n += 1
        i += 1
    return n

assert(zero_trip() == 0, "a loop whose bound is already met never runs")

function starts_past_bound():
    n = 0
    i = 5
    for i < 3:
        n += 1
        i += 1
    return n * 100 + i

assert(starts_past_bound() == 5, "no iterations, and the loop variable is untouched")

function inclusive_bound():
    n = 0
    i = 0
    for i <= 5:
        n += i
        i += 1
    return n

assert(inclusive_bound() == 15, "0+1+...+5")

function inclusive_zero_trip():
    n = 0
    i = 6
    for i <= 5:
        n += 1
        i += 1
    return n

assert(inclusive_zero_trip() == 0, "an inclusive bound already passed never runs")

function wide_bound():
    n = 0
    i = 5000000000
    for i < 5000000004:
        n += 1
        i += 1
    return n

assert(wide_bound() == 4, "a bound past int32 goes through the wide constant table")

function negative_bound():
    n = 0
    i = -10
    for i < -3:
        n += 1
        i += 1
    return n

assert(negative_bound() == 7, "-10 through -4")

function overshoot():
    n = 0
    i = 0
    for i < 10:
        n += 1
        i += 3
    return n * 100 + i

assert(overshoot() == 412, "steps of 3 leave i at 12 after four trips")

function break_and_continue():
    total = 0
    i = 0
    for i < 20:
        i += 1
        if i % 2 == 0:
            continue
        if i > 11:
            break
        total += i
    return total

assert(break_and_continue() == 36, "continue must still test the bound; break must leave")

function nested_same_bound():
    total = 0
    a = 0
    for a < 4:
        b = 0
        for b < 4:
            total += a * 10 + b
            b += 1
        a += 1
    return total

assert(nested_same_bound() == 264, "each loop keeps its own bound slot")

function bound_used_in_body():
    t = 0
    i = 0
    for i < 6:
        t += 6 - i
        i += 1
    return t

assert(bound_used_in_body() == 21, "the body shares the bound's slot and must not overwrite it")

function many_body_constants():
    t = 0
    i = 0
    for i < 3:
        t += i * 11 + 13 - 17 + 19 * 23 - 29
        i += 1
    return t

assert(many_body_constants() == 1245, "the bound takes a preheader slot before the body's constants do")

function real_counter():
    n = 0
    x = 0.0
    for x < 3:
        n += 1
        x += 1.0
    return n

assert(real_counter() == 3, "a real counter against an integer literal")

top_total = 0
ti = 0
for ti < 9:
    top_total += ti
    ti += 1

assert(top_total == 36, "the same rule in the top-level frame")

print("test_loop_literal_bounds.aer: all assertions passed.")
