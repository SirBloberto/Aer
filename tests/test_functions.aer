#!/usr/bin/env aer
# AER test suite — functions, the pipe operator, multiple return
# values, and destructuring.
# Machine-checked via assert(): a clean run exits 0; any failure prints
# "ASSERT FAILED: ..." and the process exits nonzero (see main.c/error.c).

# ------------------------------------------------------------------ #
# 16. Functions                                                        #
# ------------------------------------------------------------------ #

function add(a, b):
    return a + b

function factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

assert(add(3, 4) == 7, "basic function call")
assert(factorial(5) == 120, "recursion")

# Nested calls
assert(add(factorial(3), factorial(4)) == 30, "nested function calls (6 + 24 = 30)")

# Functions as values
function apply(f, x):
    return f(x)

function double(n):
    return n * 2

assert(apply(double, 10) == 20, "function passed as a value")
assert(apply(factorial, 5) == 120, "a different function passed as a value")

# Function stored in variable
fn = double
assert(fn(7) == 14, "function stored in a variable")

# Function stored in array — call directly via index
ops = [add, double]
assert(ops[0](3, 4) == 7, "OP_CALL_VALUE — function stored in an array, called via index")
assert(ops[1](5) == 10, "OP_CALL_VALUE — a different array-stored function")

# Function stored in dict
dispatch = {"add": add, "double": double}
assert(dispatch["add"](10, 20) == 30, "function stored in a dict, called via key")

# Bare return / falling off end returns null
function no_return():
    x = 1

result = no_return()
assert(result == null, "falling off the end of a function returns null")

# ------------------------------------------------------------------ #
# 17. Anonymous function expressions                                   #
# ------------------------------------------------------------------ #

# function(params): body — a function VALUE, not a declaration. Can be
# assigned, returned, or passed just like any other value. Compiles exactly
# like a named function otherwise — it can only see its own parameters and
# locals, plus true globals; there is no capture of an enclosing function's
# variables (AER has no closures — a function's data access is always
# either its own parameters/locals, or an explicit reference passed in).
square = function(n):
    return n * n
assert(square(5) == 25, "anonymous function expression")

# Named function statements (`function foo(): ...`) still cannot be
# nested at all — only function EXPRESSIONS can appear inside a function
# body:
# function outer():
#     function inner():   # error: nested named function definitions
#         return 1          # are not supported
#     return inner()

# A function expression nested inside another function body can still
# reference its OWN parameters/locals and true globals, same as any
# function — but not the enclosing function's locals, since there's no
# capture mechanism. That would be a plain 'not defined' error:
# function make_thing():
#     x = 1
#     inner = function():
#         return x           # error: 'x' is not defined — no capture
#     return inner()

# ------------------------------------------------------------------ #
# 18. Pipe operator — |>                                               #
# ------------------------------------------------------------------ #

# x |> f(args) desugars to f(x, args) — x becomes argument zero
function increment(n, amount):
    return n + amount

piped = 5 |> increment(3)
assert(piped == 8, "pipe operator desugars to a normal call")

# Chains read left to right
function square2(n):
    return n * n

result2 = 3 |> increment(1) |> square2()
assert(result2 == 16, "pipe chains read left to right ((3+1)^2 = 16)")

# Enforced: no function calls anywhere inside a pipe target's arguments,
# at any depth — keeps pipe chains flat and readable.
# 5 |> increment(square(2))            # would error: nested call not allowed
# 5 |> increment(2 |> square())        # would also error (nested pipe's own call)

# A pipe chain used as a statement (its result discarded), not just as the
# right-hand side of an assignment — from a bare name and from a field
# chain. Both land in parse_assignment's non-assignment fallbacks, which
# used to hard-error ("Expected assignment operator..." / "Compound
# assignment ... is not supported") since only calls and assignments were
# recognized as valid statement shapes.
function pipe_stmt_append(entry, tag):
    append(entry, tag)

numbers_list = [1, 2, 3]
numbers_list |> pipe_stmt_append("touched")
assert(length(numbers_list) == 4 && numbers_list[3] == "touched",
       "a bare-name pipe chain works as a statement, not just an expression")

struct Basket:
    items: any = []

basket = Basket([1, 2])
basket.items |> pipe_stmt_append("added")
assert(length(basket.items) == 3 && basket.items[2] == "added",
       "a field-chain pipe (a.b |> f(...)) works as a statement too")

# Calling a function value reached through indexing/field access, as a bare
# statement (not assigned to anything) — functions stored in an array/dict
# and dispatched dynamically is a common pattern once functions are
# first-class values. This landed in the same fallback as the pipe-as-
# statement cases above: previously only a bare `name(args)` call was
# recognized as a statement; `queue[i](args)` hit the same "compound
# assignment" error pipe chains used to.
function log_a(log):
    append(log, "a")
function log_b(log):
    append(log, "b")

call_log = []
queue = [log_a, log_b]
for i in 0..length(queue):
    queue[i](call_log)
assert(length(call_log) == 2 && call_log[0] == "a" && call_log[1] == "b",
       "calling a function value via queue[i](args) works as a bare statement")

# ------------------------------------------------------------------ #
# 19. Multiple return values                                           #
# ------------------------------------------------------------------ #

function min_max(arr):
    lo = arr[0]
    hi = arr[0]
    for v in arr:
        if v < lo:
            lo = v
        if v > hi:
            hi = v
    return lo, hi

lo, hi = min_max([3, 1, 4, 1, 5, 9, 2, 6])
assert(lo == 1 && hi == 9, "multiple return values, destructured directly")

# ------------------------------------------------------------------ #
# 20. Destructuring                                                    #
# ------------------------------------------------------------------ #

a2, b2 = 10, 20
assert(a2 == 10 && b2 == 20, "destructuring from a comma-separated expression list")

a2, b2 = b2, a2                          # swap — RHS fully evaluated before assignment
assert(a2 == 20 && b2 == 10, "destructuring swap — RHS fully evaluated before any assignment")

# ------------------------------------------------------------------ #
# 21. Default parameters                                               #
# ------------------------------------------------------------------ #

function greet(name, greeting = "Hello"):
    return "{greeting}, {name}!"

assert(greet("World") == "Hello, World!", "a trailing default is used when the argument is omitted")
assert(greet("World", "Hi") == "Hi, World!", "a trailing default is overridden when the argument is supplied")

function add3(a, b = 10, c = 100):
    return a + b + c

assert(add3(1) == 111, "two trailing defaults, zero supplied")
assert(add3(1, 2) == 103, "two trailing defaults, one supplied")
assert(add3(1, 2, 3) == 6, "two trailing defaults, both supplied — no default should apply")

f = greet
assert(f("Value") == "Hello, Value!", "a default still applies through a function-value call (OP_CALL_VALUE), not just a named call")

print("test_functions.aer: all assertions passed.")
