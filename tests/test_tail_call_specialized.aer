#!/usr/bin/env aer
# AER test suite — tail calls inside a specialized body.
#
# Each function is called enough times to specialize before the case that matters runs, so the
# deep call executes the variant rather than the generic body. A tail call there must reuse the
# frame exactly as it does in the generic body: depth past the call-stack limit is the proof.

WARM = 20

function count_down(n, acc):
    if n <= 0:
        return acc
    return count_down(n - 1, acc + n)

w = 0
for w < WARM:
    assert(count_down(10, 0) == 55, "shallow call while warming up")
    w += 1
assert(count_down(100000, 0) == 5000050000, "deep tail recursion in the specialized body reuses its frame")

function halve_sum(n, acc):
    if n <= 0:
        return acc
    return halve_sum(n - 1, acc + 0.5)

w = 0
for w < WARM:
    assert(halve_sum(4, 0.0) == 2.0, "shallow real accumulator while warming up")
    w += 1
assert(halve_sum(100000, 0.0) == 50000.0, "deep tail recursion carrying a real accumulator")

# Arguments that swap on every call: the copy into the reused frame must read every argument before
# it overwrites any parameter the next argument came from.
function swap_down(n, a, b):
    if n <= 0:
        return a * 1000 + b
    return swap_down(n - 1, b, a)

w = 0
for w < WARM:
    assert(swap_down(2, 1, 2) == 1002, "an even number of swaps restores the order")
    w += 1
assert(swap_down(100000, 1, 2) == 1002, "deep, even: order restored")
assert(swap_down(100001, 1, 2) == 2001, "deep, odd: order reversed")

function parity_walk(n, acc):
    if n <= 0:
        return acc
    if n % 2 == 0:
        return parity_walk(n - 1, acc + 2)
    else:
        return parity_walk(n - 1, acc + 1)

w = 0
for w < WARM:
    assert(parity_walk(4, 0) == 6, "tail calls in both arms of an if, shallow")
    w += 1
assert(parity_walk(100000, 0) == 150000, "tail calls in both arms of an if, deep")

function gcd(a, b):
    if b == 0:
        return a
    return gcd(b, a % b)

w = 0
for w < WARM:
    assert(gcd(48, 18) == 6, "gcd while warming up")
    w += 1
assert(gcd(1071, 462) == 21, "gcd in the specialized body")
assert(gcd(832040, 514229) == 1, "consecutive Fibonacci numbers, the deepest gcd chain for their size")

# A self-call that is not in tail position still pushes a frame, and still gets the right answer.
function fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

assert(fib(20) == 6765, "non-tail self recursion in the specialized body")

print("test_tail_call_specialized.aer: all assertions passed.")
