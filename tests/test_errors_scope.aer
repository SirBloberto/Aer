#!/usr/bin/env aer
# AER test suite — errors-as-values vs. runtime errors, scope semantics,
# and panic().
# Machine-checked via assert(): a clean run exits 0; any failure prints
# "ASSERT FAILED: ..." and the process exits nonzero (see main.c/error.c).

# ------------------------------------------------------------------ #
# 21. Errors as values (user convention) vs. runtime errors (VM)       #
# ------------------------------------------------------------------ #

# User-level convention: fallible functions return (value, null) or
# (null, "message"). This is a coding pattern, not VM-enforced.
function safe_div(a, b):
    if b == 0:
        return null, "division by zero"
    return a / b, null

result3, err = safe_div(10, 2)
assert(err == null && result3 == 5, "safe_div succeeds when the divisor isn't zero")

result3, err = safe_div(10, 0)
assert(err == "division by zero", "safe_div returns an error message when the divisor is zero")

# VM-level runtime errors (out-of-bounds, wrong type, div by zero via /,
# wrong arg count, etc.) are different: they print a message and abort
# the *current statement* in the REPL (nothing after the error point in
# that statement runs), or exit nonzero when running a file. They are NOT
# catchable values — there is no try/catch.
# print(arr[999])   # would print an error and abort this statement only

# ------------------------------------------------------------------ #
# 22. Scope                                                            #
# ------------------------------------------------------------------ #

outer = 10

# A top-level variable is entirely off-limits inside a function — no reads, no writes, and a
# local/parameter can't reuse its name either. One name means one variable, everywhere; data
# enters a function through parameters and leaves through its return value.
# function read_outer():
#     return outer            # would error: 'outer' is a top-level variable — not accessible
#                              # inside a function; pass it as a parameter (or rename)
# function shadow_outer(outer):   # would ALSO error: this parameter name shadows the global
#     return outer

function read_it(v):
    return v                        # v is a parameter, not the global — this is fine

assert(read_it(outer) == 10, "the value has to be passed in explicitly; a function has no ambient access to it")

# To update shared state from inside a function, mutate something you were explicitly
# given a reference to (a struct/array/dict), not a bare name — see the Scope section
# of the README.
struct Counter:
    value: integer = 0

function bump(c):
    c.value += 1

shared = Counter(10)
bump(shared)
assert(shared.value == 11, "explicit mutation through a passed-in reference still works")

# Variables inside blocks are local to that block
for i in 0..3:
    inner = i * 2

# print(inner)   # would error: 'inner' is not defined

# Named functions cannot be defined inside other functions — a nested
# function's variable lookups would only work by accident (only while the
# enclosing call is still on the stack). This is a parse error, not a
# runtime one:
# function make_thing():
#     function helper():        # error: nested function definitions are
#         return 1                # not supported
#     return helper()

# ------------------------------------------------------------------ #
# 27. panic()                                                          #
# ------------------------------------------------------------------ #

# panic()'s abort behavior can't be exercised from inside this file — a
# runtime error (which panic() triggers, same as any other) aborts the
# whole file in file mode, same as every other runtime fault. It's covered
# by tests/embed_smoke_test.c instead, where a host can inspect vm_run()'s
# return value without killing the test run itself.

print("test_errors_scope.aer: all assertions passed.")
