#!/usr/bin/env aer
# AER test suite — the "primitive pass" (raw unboxed storage for provably-monotype int/float
# locals, source/core/vm.h's OP_RAW_* family + parser.c's var_kind). Ground-truth coverage: every
# result here must match exactly what the fully-boxed VM would have produced, since this feature
# is purely an internal storage optimization — no AER program's observable behavior should change.
# Machine-checked via assert(): a clean run exits 0; any failure prints "ASSERT FAILED: ..." and
# the process exits nonzero (see main.c/error.c).

# ------------------------------------------------------------------ #
# Raw arithmetic — int and float, matching boxed semantics exactly     #
# ------------------------------------------------------------------ #

function raw_int_arith():
    a = 10
    b = 3
    sum = a + b
    diff = a - b
    prod = a * b
    quot = a / b          # int/int division always promotes to float, even when raw
    rem = a % b
    fdiv = a // b
    return [sum, diff, prod, quot, rem, fdiv]

r = raw_int_arith()
assert(r[0] == 13 and r[1] == 7 and r[2] == 30, "raw int add/sub/mul match boxed semantics")
assert(r[3] == 10.0 / 3.0, "raw int division promotes to float (matching OP_DIV's own boxed semantics)")
assert(r[4] == 1 and r[5] == 3, "raw int mod/floor_div stay integer")

# OP_RAW_LOAD_INT's immediate is a signed 20-bit field (-524288..524287) — a literal outside that
# range must go through the constant pool (OP_RAW_LOAD_INT_POOL), not be silently truncated. Real
# bug found exactly this way: a raw loop bound of 20,000,000 truncated to 77,056, silently running
# a 20-million-iteration loop only 77,056 times — wrong output, no crash, no compile error.
function large_raw_literal():
    big = 20000000
    small = 5
    return [big, big + 1, big * 2]

bl = large_raw_literal()
assert(bl[0] == 20000000, "a raw int literal outside OP_RAW_LOAD_INT's 20-bit immediate range loads correctly via the pool fallback")
assert(bl[1] == 20000001 and bl[2] == 40000000, "arithmetic on a pool-loaded large raw literal is still correct")

function large_raw_loop_bound():
    total = 0
    i = 0
    for i < 600000:          # 600000 exceeds OP_RAW_LOAD_INT's 20-bit signed range (max 524287)
        total += 1
        i += 1
    return total

assert(large_raw_loop_bound() == 600000, "a loop bounded by a raw literal over the 20-bit immediate range runs the correct number of iterations, not a truncated count")

function raw_real_arith():
    a = 2.5
    b = 4.0
    return [a + b, a - b, a * b, a / b]

rr = raw_real_arith()
assert(rr[0] == 6.5 and rr[1] == -1.5 and rr[2] == 10.0 and rr[3] == 0.625, "raw float arithmetic matches boxed semantics")

# ------------------------------------------------------------------ #
# Shadow transition — a raw-tracked name reassigned to a different    #
# type, UNCONDITIONALLY (outside any loop). A plain-assignment shadow  #
# textually inside a loop is a compile error instead (same hazard as   #
# compound assignment's own loop restriction) — see embed_smoke_test.c #
# ------------------------------------------------------------------ #

function shadow_transition():
    x = 5                  # x starts raw-int
    before = x + 1          # raw arithmetic while it's still an int
    x = "now a string"      # shadows to boxed
    return [before, x]

s = shadow_transition()
assert(s[0] == 6, "raw arithmetic before the shadow used the correct raw int value")
assert(s[1] == "now a string", "the variable correctly holds the new type after shadowing")

# ------------------------------------------------------------------ #
# Branch disqualification — a FRESH name first assigned different      #
# types down mutually-exclusive branches must never go raw (the        #
# phi/merge problem) — both paths must still produce correct results   #
# ------------------------------------------------------------------ #

function branch_disqualification(flag):
    if flag:
        y = 5
    else:
        y = "text"
    return y

assert(branch_disqualification(true) == 5, "branch-local int path still correct")
assert(branch_disqualification(false) == "text", "branch-local string path still correct")

# A branch reassigning an EXISTING raw name to the SAME kind must stay raw and correct —
# this is the common, safe case (accumulators inside if/loop bodies) that must NOT be
# needlessly restricted just because it's inside a branch.
function branch_same_kind_reassignment(flag):
    total = 0
    if flag:
        total = total + 100
    else:
        total = total + 1
    return total

assert(branch_same_kind_reassignment(true) == 100, "same-kind reassignment inside an if-branch stays raw and correct")
assert(branch_same_kind_reassignment(false) == 1, "same-kind reassignment inside an else-branch stays raw and correct")

# ------------------------------------------------------------------ #
# Compound assignment on a raw-tracked local — inside a loop AND a     #
# branch, same-kind (the accumulator/physics-variable pattern this     #
# whole feature targets)                                               #
# ------------------------------------------------------------------ #

function compound_assign_raw(n):
    total = 0
    i = 1
    for i <= n:
        if i % 2 == 0:
            total += i
        i += 1
    return total

assert(compound_assign_raw(10) == 30, "compound += on raw locals inside a loop+branch, summing even numbers 2+4+6+8+10")

# ------------------------------------------------------------------ #
# Escape sites — a raw local used somewhere that needs a real boxed    #
# AerVal: call argument, return value, container element, string       #
# interpolation, comparison against a dynamic/boxed value               #
# ------------------------------------------------------------------ #

function identity(v):
    return v

function escape_sites():
    n = 42
    passed_through = identity(n)          # call argument
    arr = [n, n + 1]                      # array element
    d = {"key": n}                        # hashtable value
    interpolated = "value is {n}"          # string interpolation
    return [passed_through, arr[0], arr[1], d["key"], interpolated]

es = escape_sites()
assert(es[0] == 42, "raw local passed as a call argument boxes correctly")
assert(es[1] == 42 and es[2] == 43, "raw locals written into array elements box correctly")
assert(es[3] == 42, "raw local written into a hashtable value boxes correctly")
assert(es[4] == "value is 42", "raw local interpolated into a string boxes correctly")

struct Holder:
    value = 0
function escape_to_struct():
    n = 7
    h = Holder(n)          # struct construction argument
    h.value = n * 2        # struct field write from a raw expression
    return h.value

assert(escape_to_struct() == 14, "raw local used in struct construction and field-set boxes correctly")

# ------------------------------------------------------------------ #
# A field-read-derived value must never be classified raw itself       #
# (raw composability only chains through literals/already-raw values,  #
# never through a container read) — otherwise the OP_FIELD_BINARY/     #
# OP_BINARY_FIELD fusion in parse_binary_ops could misfire.            #
# ------------------------------------------------------------------ #

struct Vec:
    x = 0.0
function field_derived_not_raw():
    v = Vec(3.0)
    result = v.x + 1        # v.x is a field read — result computed correctly either way
    return result

assert(field_derived_not_raw() == 4.0, "arithmetic on a struct-field read produces the correct value")

# ------------------------------------------------------------------ #
# A raw local used as a while-loop condition (the OP_RAW_LT/GT/LTE/    #
# GTE family — closes the "boxes every iteration" gap the design       #
# doc flagged)                                                          #
# ------------------------------------------------------------------ #

function raw_while_condition(limit):
    count = 0
    x = 0
    for x < limit:
        count += 1
        x += 1
    return count

assert(raw_while_condition(7) == 7, "a raw local used directly in a while-style loop condition terminates correctly")

# ------------------------------------------------------------------ #
# Raw-slot overflow — a function with more raw-eligible locals than    #
# the 32-slot budget must gracefully fall back to boxed, not crash     #
# or silently truncate                                                 #
# ------------------------------------------------------------------ #

function many_raw_locals():
    v0 = 0
    v1 = 1
    v2 = 2
    v3 = 3
    v4 = 4
    v5 = 5
    v6 = 6
    v7 = 7
    v8 = 8
    v9 = 9
    v10 = 10
    v11 = 11
    v12 = 12
    v13 = 13
    v14 = 14
    v15 = 15
    v16 = 16
    v17 = 17
    v18 = 18
    v19 = 19
    v20 = 20
    v21 = 21
    v22 = 22
    v23 = 23
    v24 = 24
    v25 = 25
    v26 = 26
    v27 = 27
    v28 = 28
    v29 = 29
    v30 = 30
    v31 = 31
    v32 = 32
    v33 = 33
    v34 = 34
    v35 = 35
    return (v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15 +
            v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28 + v29 +
            v30 + v31 + v32 + v33 + v34 + v35)

assert(many_raw_locals() == 630, "a function with 36 int locals (over the 32 raw-int-slot budget) still computes correctly via graceful fallback to boxed for the overflow")

# ------------------------------------------------------------------ #
# Deep recursion with raw int/real locals live in every stacked frame  #
# -- raw_ints[]/raw_reals[] moved from a fixed per-frame array to a    #
# shared bump-pointer bank (mirroring registers[]/register_stack).     #
# Each recursive activation's own raw slots must stay isolated from    #
# every other still-live activation's, or this would silently corrupt  #
# a sibling frame's accumulator instead of crashing outright.          #
# ------------------------------------------------------------------ #

function recursive_raw_sum(n):
    total = 0        # raw int, live across the whole recursive descent
    scale = 1.5       # raw real, live across the whole recursive descent
    i = 0
    for i < n:
        total += i
        i += 1
    if n <= 1:
        return float(total) * scale
    return float(total) * scale + recursive_raw_sum(n - 1)

# 50 levels deep (VM_CALL_MAX is 64) -- deep enough to stress many simultaneously-live raw
# frames sharing one backing array, shallow enough to stay well clear of a real stack overflow.
expected = 0.0
tlx_k = 1
for tlx_k <= 50:
    tlx_partial = 0
    tlx_j = 0
    for tlx_j < tlx_k:
        tlx_partial += tlx_j
        tlx_j += 1
    expected += float(tlx_partial) * 1.5
    tlx_k += 1
assert(recursive_raw_sum(50) == expected, "50 levels of recursion, each with its own live raw int + raw real local, all isolated correctly via the shared bump-pointer raw stack")

# A recursive numeric function passes its argument and result as raw scalars (OP_CALL_RAW_*),
# so the int and float forms must each still produce exactly what the boxed version did. Each
# recurses past NUMERIC_SPECIALIZE_AFTER (vm.h) -- a shallower call never specializes at all, and
# would test the boxed path while appearing to cover these opcodes.
function raw_call_int(n):
    if n <= 0:
        return 0
    return n + raw_call_int(n - 1)
assert(raw_call_int(20) == 210, "an int-parameter recursive call passing and returning raw scalars still sums correctly")
assert(raw_call_int(0) == 0, "its base case returns raw without recursing")

function raw_call_real(x):
    if x <= 0.0:
        return 0.0
    return x + raw_call_real(x - 1.0)
assert(raw_call_real(20.0) == 210.0, "a float-parameter recursive call passing and returning raw scalars still sums correctly")

# The parameter is int but the result is a float -- the call site must take the result from the
# float bank, not truncate it into the int one.
function raw_call_int_to_real(n):
    if n <= 0:
        return 0.5
    return 1.5 + raw_call_int_to_real(n - 1)
assert(raw_call_int_to_real(20) == 30.5, "a raw call whose result kind differs from its parameter kind keeps the result exact")

# ------------------------------------------------------------------ #
# Raw locals live across an OP_CALL_VALUE boundary (call through a     #
# variable, not a direct named call like recursive_raw_sum above) --   #
# a third frame-push path (alongside OP_CALL and setup_call above)     #
# that must agree on the same raw_ints/raw_reals bump-pointer sizing.  #
# ------------------------------------------------------------------ #

function raw_callee(m):
    inner_total = 0
    j = 0
    for j < m:
        inner_total += j
        j += 1
    return inner_total

function raw_caller_via_value(fn, n):
    outer_total = 0        # raw int, live in THIS frame across the call-through-value below
    outer_scale = 2.0        # raw real, same
    i = 0
    for i < n:
        outer_total += fn(i)          # fn is a parameter (boxed) holding a function value -> OP_CALL_VALUE
        i += 1
    return float(outer_total) * outer_scale

expected_via_value = 0.0
tlx_n2 = 0
for tlx_n2 < 6:
    tlx_inner = 0
    tlx_j2 = 0
    for tlx_j2 < tlx_n2:
        tlx_inner += tlx_j2
        tlx_j2 += 1
    expected_via_value += float(tlx_inner)
    tlx_n2 += 1
expected_via_value = expected_via_value * 2.0
assert(raw_caller_via_value(raw_callee, 6) == expected_via_value, "the caller's own raw locals survive an OP_CALL_VALUE call (function-through-a-variable) to another function with its own independent raw locals")

# ------------------------------------------------------------------ #
# A raw real value composed with a BOXED value whose runtime type is  #
# integer, not real -- must promote (matching the fully-boxed path's  #
# own int/real mixing rule), not reject as a type error. Found via a  #
# real bug: `i * 0.10` inside a range-for loop (`i` an ordinary boxed  #
# ORiter value at the point it composes here, 0.10 a raw real literal) #
# raised "Cannot apply '*=' to float and integer" before this fix --   #
# the OP_RAW_*_REAL_BOXED opcodes required an exact TYPE_REAL match    #
# with no promotion, unlike every other numeric path in the language.  #
# ------------------------------------------------------------------ #

function scale_by_index(n):
    total = 0.0
    for i in 0..n:
        total += i * 0.10          # raw-real-literal * boxed-int(i), general expression, not compound-assign
    return total

st = scale_by_index(5)
assert(st == 0.0 + 0.10 + 0.20 + 0.30 + 0.40, "i * 0.10 (boxed int times a raw real literal) promotes correctly inside a general expression")

function accumulate_int_into_real(n):
    total = 0.0
    i = 0
    for i < n:
        total += get_int(i)        # a genuinely boxed int (function return, never raw) accumulated into a raw real local
        i += 1
    return total

function get_int(x):
    return x

ai = accumulate_int_into_real(4)
assert(ai == 0.0 + 1.0 + 2.0 + 3.0, "a raw real local's own compound assignment ('+=') also promotes a boxed integer rhs correctly")

print("test_primitive_pass.aer: all assertions passed.")
