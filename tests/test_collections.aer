#!/usr/bin/env aer
import collection
import string
# AER test suite — arrays, hashtables, and nested collections.
# Machine-checked via assert(): a clean run exits 0; any failure prints
# "ASSERT FAILED: ..." and the process exits nonzero (see main.c/error.c).

# ------------------------------------------------------------------ #
# 13. Arrays                                                           #
# ------------------------------------------------------------------ #

arr = [10, 20, 30]
assert(arr[0] == 10, "array indexing")
assert(arr[-1] == 30, "negative array indexing")

arr[1] = 99
assert(arr[0] == 10 and arr[1] == 99 and arr[2] == 30, "array index assignment")

collection.append(arr, 40)
assert(length(arr) == 4 and arr[3] == 40, "append adds to the end and updates length")

# collection.delete(arr, index) removes by index, shifting subsequent elements down to
# preserve order — negative indices work the same as bracket indexing.
collection.delete(arr, 1)                        # removes 99
assert(length(arr) == 3 and arr[0] == 10 and arr[1] == 30 and arr[2] == 40, "delete by index shifts subsequent elements down")

collection.delete(arr, -1)                       # removes the last element (40)
assert(length(arr) == 2 and arr[0] == 10 and arr[1] == 30, "collection.delete(-1) removes the last element — no separate pop() needed")

# collection.append()/collection.delete() both mutate in place and also return the array; the
# return value is only useful if you don't already have a reference to it.
# collection.delete(arr, 99)   # would error: Array index 99 out of bounds (len 2)

# Slicing — [a:b], [a:], [:b], [:] — always returns a new array
nums2 = [0, 1, 2, 3, 4, 5]
assert(nums2[1:4][0] == 1 and nums2[1:4][1] == 2 and nums2[1:4][2] == 3 and length(nums2[1:4]) == 3, "array slice [a:b]")
assert(length(nums2[3:]) == 3 and nums2[3:][0] == 3, "array slice [a:]")
assert(length(nums2[:3]) == 3 and nums2[:3][0] == 0, "array slice [:b]")
assert(length(nums2[:]) == 6, "array slice [:] copies the whole array")

# Arrays have reference semantics — assignment copies the reference
a = [1, 2, 3]
b = a
b[0] = 99
assert(a[0] == 99, "arrays are references — mutating b also mutates a")

# Truthiness: empty array is falsy, non-empty is truthy
non_empty_arr_label = "unset"
if [1]:
    non_empty_arr_label = "not empty"
else:
    non_empty_arr_label = "empty"
assert(non_empty_arr_label == "not empty", "non-empty array is truthy")

empty_arr = []
empty_arr_label = "unset"
if empty_arr:
    empty_arr_label = "truthy"
else:
    empty_arr_label = "falsy"
assert(empty_arr_label == "falsy", "empty array is falsy")

# ------------------------------------------------------------------ #
# 14. Hashtables                                                            #
# ------------------------------------------------------------------ #

d = {"x": 1, "y": 2}
assert(d["x"] == 1, "hashtable indexing")
assert(d["missing"] == null, "missing key returns null, not an error")

d["z"] = 3
assert("z" in d, "hashtable key assignment")
assert(length(d) == 3, "hashtable length after assignment")

collection.delete(d, "y")
assert(not "y" in d, "delete removes a hashtable key")

# Keys are length-bounded only by memory. Every dict path (set, get, `in`, delete) once copied its
# key through a fixed 4096-byte stack buffer, so anything longer was a runtime error.
long_key = string.repeat("k", 5000)
other_long_key = string.repeat("k", 4999) + "j"
big = {}
big[long_key] = "stored"
assert(length(long_key) == 5000, "a key well past the old 4096-byte cap builds fine")
assert(big[long_key] == "stored", "a 5000-byte key round-trips through set and get")
assert(long_key in big, "`in` matches a 5000-byte key")
assert(not (other_long_key in big), "two 5000-byte keys differing in the last byte stay distinct")
collection.delete(big, long_key)
assert(not (long_key in big), "delete removes a 5000-byte key")

# Hashtables have reference semantics
d1 = {"a": 1}
d2 = d1
d2["a"] = 99
assert(d1["a"] == 99, "hashtables are references — mutating d2 also mutates d1")

# Truthiness: empty hashtable is falsy
empty_dict = {}
empty_dict_label = "unset"
if empty_dict:
    empty_dict_label = "truthy"
else:
    empty_dict_label = "falsy"
assert(empty_dict_label == "falsy", "empty hashtable is falsy")

# ------------------------------------------------------------------ #
# 15. Nested collections                                               #
# ------------------------------------------------------------------ #

matrix = [[1, 2], [3, 4]]
assert(matrix[0][1] == 2, "nested array indexing")
assert(matrix[1][0] == 3, "nested array indexing")

matrix[0][1] = 99                    # chained index assignment
assert(matrix[0][0] == 1 and matrix[0][1] == 99, "chained nested index assignment")

record = {"name": "Alice", "scores": [100, 95, 88]}
assert(record["scores"][0] == 100, "hashtable containing an array")
assert(record["scores"][-1] == 88, "hashtable containing an array, negative index")

nested = {"a": {"b": {"c": 42}}}
assert(nested["a"]["b"]["c"] == 42, "deeply nested hashtables")

# ------------------------------------------------------------------ #
# 16. collection module — copy, insert, index_of, keys, sort           #
# ------------------------------------------------------------------ #

orig = [1, 2, 3]
copied = collection.copy(orig)
copied[0] = 99
assert(orig[0] == 1 and copied[0] == 99, "collection.copy(array) is a real copy — mutating it leaves the original alone")
assert(length(copied) == 3, "collection.copy(array) preserves length")

orig_d = {"x": 1, "y": 2}
copied_d = collection.copy(orig_d)
copied_d["x"] = 99
assert(orig_d["x"] == 1 and copied_d["x"] == 99, "collection.copy(hashtable) is a real copy")
assert(length(copied_d) == 2 and copied_d["y"] == 2, "collection.copy(hashtable) preserves every entry")

ins = [1, 3]
collection.insert(ins, 1, 2)
assert(length(ins) == 3 and ins[0] == 1 and ins[1] == 2 and ins[2] == 3, "collection.insert() places the value at the index, shifting the rest up")
collection.insert(ins, 3, 4)
assert(ins[3] == 4, "collection.insert() at index == length appends")
collection.insert(ins, 0, 0)
assert(ins[0] == 0 and ins[4] == 4, "collection.insert() at 0 prepends")

haystack = ["a", "b", "c", "b"]
assert(collection.index_of(haystack, "b") == 1, "collection.index_of() returns the first match's index")
assert(collection.index_of(haystack, "z") == -1, "collection.index_of() returns -1 when absent")

key_dict = {"beta": 2, "alpha": 1}
key_list = collection.sort(collection.keys(key_dict))
assert(length(key_list) == 2 and key_list[0] == "alpha" and key_list[1] == "beta",
       "collection.keys() returns every key — sorted here since hashtable iteration order is unspecified")

sorted_here = collection.sort([3, 1, 2])
assert(sorted_here[0] == 1 and sorted_here[2] == 3, "collection.sort() on numbers (moved from math.sort)")

# Typed arrays slice with the same spelling as arrays and strings, and produce a typed array of the
# same element kind -- a copy, like the other two, not a view onto the original.
tslice_src = [0.0; 8]
tsi = 0
for tsi < 8:
    tslice_src[tsi] = float(tsi) * 1.5
    tsi += 1
tslice = tslice_src[2:5]
assert(length(tslice) == 3, "slicing a typed array yields the requested length")
assert(tslice[0] == 3.0 and tslice[2] == 6.0, "a typed-array slice carries the right elements")
tslice_src[2] = 99.0
assert(tslice[0] == 3.0, "a typed-array slice is a copy, so writing the original doesn't change it")
assert(length(tslice_src[3:3]) == 0, "an empty typed-array slice")
assert(length(tslice_src[-3:]) == 3, "a negative typed-array slice bound counts from the end")
tslice_int = [0i; 6]
tslice_int[4] = 9
assert(tslice_int[3:6][1] == 9, "slicing preserves the element kind (int32 here)")

# `[fill; n]` accepts a typed array, so a matrix is one expression. Each row must be its own copy --
# sharing one row `n` times is the trap Python's `[[0] * cols] * rows` is known for.
mat = [[0.0; 4]; 3]
assert(length(mat) == 3 and length(mat[0]) == 4, "a nested repeat-literal builds rows x cols")
mat[1][2] = 7.5
assert(mat[0][2] == 0.0 and mat[1][2] == 7.5 and mat[2][2] == 0.0,
       "rows of a nested repeat-literal are independent, not one shared row")

# sum/min/max read the same on either storage, so a caller need not know which one they hold.
red_t = [0.0f; 5]
redi = 0
for redi < 5:
    red_t[redi] = float(redi) + 1.0
    redi += 1
assert(collection.sum(red_t) == 15.0, "sum over a typed float array")
assert(collection.min(red_t) == 1.0 and collection.max(red_t) == 5.0, "min/max over a typed float array")

red_i = [0i; 4]
red_i[0] = 7
red_i[1] = 3
red_i[2] = -2
red_i[3] = 12
assert(collection.sum(red_i) == 20, "sum over a typed int array stays an integer")
assert(collection.min(red_i) == -2 and collection.max(red_i) == 12, "min/max over a typed int array")

assert(collection.sum([4, 1, 9, 2]) == 16, "sum over an ordinary integer array")
assert(collection.min([4, 1, 9, 2]) == 1 and collection.max([4, 1, 9, 2]) == 9,
       "min/max over an ordinary array")
assert(collection.sum([1, 2.5, 3]) == 6.5, "one real element widens the whole sum to a real")
assert(collection.sum([]) == 0, "summing nothing is zero")

# The accumulator is always a double, never the element type. One float32 step at 1e7 is ~1.19, so
# every 0.1 here would vanish into a float32 running total and the answer would stay at 1e7 exactly.
wide = [0.1f; 20001]
wide[0] = 10000000.0
assert(collection.sum(wide) > 10001000.0,
       "the total is accumulated in a double, so addends far smaller than one step of the element type still count")

# Everything that can work on a typed array does; the four that resize say why they cannot.
srt = [0.0f; 3]
srt[0] = 3.5
srt[1] = 1.5
srt[2] = 2.5
assert(collection.index_of(srt, 2.5) == 2, "index_of finds an element of a typed array")
assert(collection.index_of(srt, 9.9) == -1, "index_of reports a miss on a typed array")
srt_copy = collection.copy(srt)
srt_copy[0] = 99.0
assert(srt[0] == 3.5 and srt_copy[0] == 99.0, "copy of a typed array is independent of the original")
collection.sort(srt)
assert(srt[0] == 1.5 and srt[1] == 2.5 and srt[2] == 3.5, "sort orders a typed array in place")

# group_sum scatters: each element lands in the accumulator its group names. That is the one thing
# whole-array arithmetic cannot express, and without it a GROUP BY costs one masked pass per group.
gs_v = [0.0; 8]
gs_g = [0.0; 8]
gsi = 0
for gsi < 8:
    gs_v[gsi] = float(gsi) + 1.0
    gs_g[gsi] = float(gsi % 3)
    gsi += 1
# values 1..8, groups 0,1,2,0,1,2,0,1
gs_r = collection.group_sum(gs_v, gs_g, 3)
assert(gs_r[0] == 12.0 and gs_r[1] == 15.0 and gs_r[2] == 9.0, "group_sum totals each group")
assert(collection.sum(gs_r) == 36.0, "and every element lands in exactly one group")
assert(length(gs_r) == 3, "the result has one entry per group")

# Integer values and integer groups keep their kind.
gsi_v = [0i; 6]
gsi_g = [0i; 6]
gsi = 0
for gsi < 6:
    gsi_v[gsi] = gsi + 1
    gsi_g[gsi] = gsi % 2
    gsi += 1
gsi_r = collection.group_sum(gsi_v, gsi_g, 2)
assert(gsi_r[0] == 9 and gsi_r[1] == 12, "group_sum over integer columns stays integer")

# A group with no rows is zero, not missing.
gs_sparse = collection.group_sum(gs_v, gs_g, 5)
assert(length(gs_sparse) == 5 and gs_sparse[3] == 0.0 and gs_sparse[4] == 0.0,
       "groups nothing landed in are zero")

# An array expression handed to sum() or group_sum() is evaluated a tile at a time and never written
# out at full size. The fusion is invisible, so what matters is that it agrees with the unfused
# spelling everywhere -- especially where operand ORDER decides the answer.
fa = [0.0; 6]
fb = [0.0; 6]
fd = [0.0; 6]
fg = [0.0; 6]
fi = 0
for fi < 6:
    fa[fi] = float(fi) + 1.0
    fb[fi] = float(fi) * 2.0
    fd[fi] = float(fi) * 0.1
    fg[fi] = float(fi % 3)
    fi += 1

# A tree, not a left-associative run: the second operator opens a fresh subexpression.
assert(collection.sum(fa * fb * (1.0 - fd) * fa) == 403.2, "sum over an operator tree")

# The subtraction compiles before `fb` is ever mentioned, so taking the stack in emission order
# would compute (fa * fd) - fb instead. Non-commutative operators are where that shows.
assert(collection.sum(fb - (fa * fd)) == 23.0, "a subtree on the left of a non-commutative operator")
assert(collection.sum((fa - fb) * fd) == -4.0, "subtraction inside a product")

# A comparison inside the expression is a filter, and costs no pass of its own.
assert(collection.sum((fa > fb) * fa) == 1.0, "a comparison against another column")
assert(collection.sum((fa > 2.0) * (fb < 9.0) * fa) == 12.0, "two comparisons and a constant")

# The first group lands a shade under 16.8 either way -- `1.0 - fd` already carries a rounding error
# -- so this brackets the value rather than asking the decimal to come out exact.
gt = collection.group_sum(fa * fb * (1.0 - fd), fg, 3)
assert(gt[0] > 16.79 and gt[0] < 16.81 and gt[1] > 27.59 and gt[1] < 27.61 and
       gt[2] > 39.59 and gt[2] < 39.61, "group_sum over an operator tree")

gm = collection.group_sum(fa * (fa > 2.0), fg, 3)
assert(gm[0] == 4.0 and gm[1] == 5.0 and gm[2] == 9.0, "group_sum under a filter")

# A named intermediate is read twice, so folding it would evaluate it twice per tile. It must stay
# materialised -- and either way the answer is the same.
shared = fa * fb
assert(collection.sum(shared * shared) == 5936.0, "a shared subexpression is not folded")

# One operator is below the threshold where fusing pays; it still has to be right.
assert(collection.sum(fa * fb) == 140.0, "a single operator is left alone")

# The fused and unfused spellings agree on an empty column, where there is nothing to tile.
none = [0.0; 0]
assert(collection.sum(none * none * none) == 0.0, "an empty column sums to zero")

# Sorting a column runs a per-kind three-way quicksort rather than qsort. The shapes below are the
# ones a quicksort gets wrong: all-equal and already-ordered input degenerate a two-way partition,
# and a column that repeats with a period defeats any fixed-stride pivot sample.
so_empty = [0.0; 0]
collection.sort(so_empty)
assert(length(so_empty) == 0, "sorting an empty column")

so_one = [5.0; 1]
collection.sort(so_one)
assert(so_one[0] == 5.0, "sorting a single element")

so_same = [7.0; 64]
collection.sort(so_same)
assert(so_same[0] == 7.0 and so_same[63] == 7.0, "every element equal")

so_n = 600
so_asc = [0.0; so_n]
so_desc = [0.0; so_n]
so_cycle = [0.0; so_n]
soi = 0
for soi < so_n:
    so_asc[soi] = float(soi)
    so_desc[soi] = float(so_n - soi)
    # Periodic, which is what defeated a fixed-stride pivot: every sample landed on the same phase.
    so_cycle[soi] = float(soi % 50) * 0.5
    soi += 1
collection.sort(so_asc)
collection.sort(so_desc)
collection.sort(so_cycle)
assert(so_asc[0] == 0.0 and so_asc[so_n - 1] == 599.0, "already ascending")
assert(so_desc[0] == 1.0 and so_desc[so_n - 1] == 600.0, "exactly descending")
assert(so_cycle[0] == 0.0 and so_cycle[so_n - 1] == 24.5, "a periodic column")

# Ordered throughout, not merely at the ends, and holding the same elements it started with.
so_ordered = true
soi = 1
for soi < so_n:
    if so_cycle[soi] < so_cycle[soi - 1]:
        so_ordered = false
    soi += 1
assert(so_ordered, "sorted at every position, not just the ends")
assert(collection.sum(so_cycle) == 7350.0, "a sort neither loses nor invents elements")

so_mix = [0.0; 5]
so_mix[0] = 3.5
so_mix[1] = -2.0
so_mix[2] = 0.0
so_mix[3] = -100.25
so_mix[4] = -2.0
collection.sort(so_mix)
assert(so_mix[0] == -100.25 and so_mix[1] == -2.0 and so_mix[2] == -2.0 and so_mix[4] == 3.5,
       "negatives and duplicates together")

so_ints = [0i; 4]
so_ints[0] = 5
so_ints[1] = -3
so_ints[2] = 12
so_ints[3] = -3
collection.sort(so_ints)
assert(so_ints[0] == -3 and so_ints[1] == -3 and so_ints[3] == 12, "an integer column")

print("test_collections.aer: all assertions passed.")
