# is_composite is a boolean[] -- one byte per flag, built in one op by the repeat literal instead of
# `limit+1` incremental appends.
function sieve(limit):
    is_composite = [false; limit + 1]
    n = length(is_composite)

    count = 0
    for p in 2..n:
        if not is_composite[p]:
            count += 1
            # A range-for (not a manual `for multiple <= limit:` while-loop) so the marking pass
            # gets the same loop-rotated single-dispatch condition+advance (OP_ITER_RANGE_LOOP)
            # every other range-for in this codebase already gets, instead of 4 separate boxed
            # dispatches (compare, jump, add, jump-back) per marked multiple. Guarded by `p*p < n`
            # first: range-for direction is inferred from start vs end (a positive step works for
            # either), so an unguarded `(p*p)..n..p` would silently iterate DESCENDING instead of
            # being empty on the (common, for p near sqrt(limit)) case where p*p already >= n.
            if p * p < n:
                for multiple in (p * p)..n..p:
                    is_composite[multiple] = true
    return count

LIMIT = 13000000
result = sieve(LIMIT)
print("Primes up to {LIMIT}: {result}")
