function sieve(limit):
    is_composite = []
    i = 0
    for i <= limit:
        append(is_composite, false)
        i += 1

    count = 0
    p = 2
    for p <= limit:
        if !is_composite[p]:
            count += 1
            multiple = p * p
            for multiple <= limit:
                is_composite[multiple] = true
                multiple += p
        p += 1
    return count

LIMIT = 10000000
result = sieve(LIMIT)
print("Primes up to {LIMIT}: {result}")
