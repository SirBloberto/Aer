import collection
import time

# Isolates the ONE mechanism the raw-fields change actually targets: field-size / cache density.
# nbody's O(n^2) inner loop keeps revisiting the same small (57-114KB) working set, which stays
# cache-resident regardless of struct size -- there's nothing for a smaller struct to save there.
# This is the opposite shape on purpose: a large 1D array, one cheap pass per iteration, so the
# array's total byte footprint (which raw fields directly shrink) actually determines how much of
# it survives in cache between passes.
struct Particle:
    x = 0.0f
    y = 0.0f
    z = 0.0f
    vx = 0.0f
    vy = 0.0f
    vz = 0.0f
    mass = 0.0f

N = 2000000
PASSES = 8

function make_particles(n):
    particles = []
    i = 0
    for i < n:
        p = Particle()
        p.x = float(i)
        p.vx = 0.0001
        p.mass = 1.0
        collection.append(particles, p)
        i += 1
    return particles

# n derived via length(particles) here (not taken as a parameter) and the loop written as
# `for i in 0..n:` (not a manual `for i < n:` while-loop) -- matching nbody.aer's advance()'s own
# idiom exactly, since that's what the loop-bound-hoisting safety proof (parser.c) keys off: it
# only recognizes a range-for whose end is a local proven == length(some parameter), not an
# arbitrary passed-in count claimed to match. Unlocks unchecked, cache-friendly array-of-structs
# indexing for `particles[i]` (SPEC_KIND_ARRAY_OF_STRUCTS) that the previous while-loop form,
# despite being computationally identical, could never qualify for.
function advance_pass(particles, dt):
    n = length(particles)
    for i in 0..n:
        pi = particles[i]
        vx = pi.vx
        vy = pi.vy
        vz = pi.vz
        pi.x += vx * dt
        pi.y += vy * dt
        pi.z += vz * dt

particles = make_particles(N)
start = time.now()
p = 0
for p < PASSES:
    advance_pass(particles, 0.01)
    p += 1
dur = time.now() - start
print("struct_array_scan: {N} particles x {PASSES} passes in {dur}s, x[0]={particles[0].x}")
