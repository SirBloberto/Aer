import time
h = {}
i = 0
for i < 500:
    h["key_{i}"] = i * 3
    i += 1
start = time.now()
total = 0
# A range-for (not a manual `for n < 400000:` while-loop) so the condition+increment collapses
# into one fused OP_ITER_RANGE_LOOP dispatch instead of 4 separate boxed ones -- same fix as
# sieve.aer/struct_array_scan.aer/mandelbrot.aer's outer loops. Fixed, non-early-exit trip count,
# same safe shape.
for n in 0..400000:
    total += h["key_{n % 500}"]
dur = time.now() - start
print("500-key table, 400k repeated lookups: {dur}s, total={total}")
