import time

# Classic language-shootout "binary-trees": build and discard many small binary trees, over and
# over. Unlike nbody/sieve/mandelbrot (which barely allocate once past setup), this stresses
# allocation and collection RATE specifically -- structs constructed and discarded constantly,
# most of them dying young. The one benchmark in this suite that's actually about the GC.
struct TreeNode:
    left = null
    right = null
    item = 0

function make_tree(depth):
    if depth == 0:
        return TreeNode(null, null, 0)
    d = depth - 1
    return TreeNode(make_tree(d), make_tree(d), depth)

function tree_checksum(node):
    if node.left == null:
        return node.item
    return node.item + tree_checksum(node.left) - tree_checksum(node.right)

MIN_DEPTH = 4
MAX_DEPTH = 10

start = time.now()

stretch_depth = MAX_DEPTH + 1
stretch_tree = make_tree(stretch_depth)
stretch_checksum = tree_checksum(stretch_tree)
print("stretch tree of depth {stretch_depth}: checksum {stretch_checksum}")

long_lived_tree = make_tree(MAX_DEPTH)

depth = MIN_DEPTH
for depth <= MAX_DEPTH:
    iterations = 1
    p = 0
    for p < depth:
        iterations *= 2
        p += 1
    total_checksum = 0
    i = 0
    for i < iterations:
        total_checksum += tree_checksum(make_tree(depth))
        i += 1
    print("{iterations} trees of depth {depth}: checksum {total_checksum}")
    depth += 2

long_lived_checksum = tree_checksum(long_lived_tree)
print("long-lived tree of depth {MAX_DEPTH}: checksum {long_lived_checksum}")

dur = time.now() - start
print("binary_trees: {dur}s")
