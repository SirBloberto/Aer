# Worker for actor_parallel.aer. Pure CPU, no I/O, no shared state -- the shape that would scale
# linearly with cores if the scheduler ran actors on more than one of them.

function work(rounds):
    acc = 0.0
    r = 0
    for r < rounds:
        i = 0
        x = 0.0
        for i < 20000:
            x = x + float(i) * 1.000001
            i += 1
        acc = acc + x
        r += 1
    return acc
