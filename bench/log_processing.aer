import time
import string
import collection

# Deliberately mundane: a small, representative "real program" rather than an adversarial
# microbenchmark. Every other script in this suite is chosen to stress one specific subsystem
# hard; this one is chosen to NOT do that -- it's meant to answer "is the common case fast",
# which is arguably the more honest number for a scripting language than any shootout extreme.
# Generates a synthetic access-log-shaped text stream, then does the kind of thing a real script
# actually does with one: split lines, count fields, tally a frequency table, format a summary.

STATUS_CODES = [200, 200, 200, 200, 301, 404, 500]
PATHS = ["/", "/index.html", "/api/users", "/api/orders", "/static/app.js", "/favicon.ico"]

function make_log_lines(n, status_codes, paths):
    lines = []
    i = 0
    for i < n:
        status = status_codes[i % length(status_codes)]
        path = paths[i % length(paths)]
        line = "{i} GET {path} {status} {i * 37 % 9973}"
        collection.append(lines, line)
        i += 1
    return lines

function process_lines(lines):
    status_counts = {}
    path_counts = {}
    total_bytes = 0
    n = length(lines)
    i = 0
    for i < n:
        parts = string.split(lines[i], " ")
        path = parts[2]
        status = parts[3]
        nbytes, nerr = string.to_integer(parts[4])
        if nerr != null:
            nbytes = 0

        if status in status_counts:
            status_counts[status] += 1
        else:
            status_counts[status] = 1

        if path in path_counts:
            path_counts[path] += 1
        else:
            path_counts[path] = 1

        total_bytes += nbytes
        i += 1
    return status_counts, path_counts, total_bytes

N = 520000

start = time.now()
lines = make_log_lines(N, STATUS_CODES, PATHS)
status_counts, path_counts, total_bytes = process_lines(lines)
dur = time.now() - start

print("log_processing: {N} lines in {dur}s, total_bytes={total_bytes}")
print("  status 200: {status_counts[\"200\"]}, 404: {status_counts[\"404\"]}, 500: {status_counts[\"500\"]}")
print("  path /: {path_counts[\"/\"]}, /api/users: {path_counts[\"/api/users\"]}")
