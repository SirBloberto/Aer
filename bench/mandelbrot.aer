import time

# Classic language-shootout Mandelbrot: pure floating-point arithmetic in tightly nested loops,
# zero allocation after setup -- the "how fast is basic arithmetic" benchmark, deliberately
# unlike nbody/sieve/dict in exercising neither struct/field access, GC pressure, nor hashing.
SIZE = 800
MAX_ITER = 200

function mandelbrot_point(cx, cy, max_iter):
    x = 0.0
    y = 0.0
    iter = 0
    for iter < max_iter:
        x2 = x * x
        y2 = y * y
        if x2 + y2 > 4.0:
            return iter
        # Compound-assignment-only form (x/y are raw-tracked floats reassigned every iteration --
        # a loop-carried PLAIN reassignment of a fixed-type local isn't supported, per the compiler's
        # own error; +=/-= don't have that restriction, so the update is expressed as a delta).
        y_new = 2.0 * x * y + cy
        x_new = x2 - y2 + cx
        y += y_new - y
        x += x_new - x
        iter += 1
    return max_iter

start = time.now()
inside_count = 0
py = 0
for py < SIZE:
    px = 0
    for px < SIZE:
        cx = (px as float) / (SIZE as float) * 3.5 - 2.5
        cy = (py as float) / (SIZE as float) * 2.0 - 1.0
        if mandelbrot_point(cx, cy, MAX_ITER) == MAX_ITER:
            inside_count += 1
        px += 1
    py += 1
dur = time.now() - start
print("mandelbrot {SIZE}x{SIZE}: {dur}s, inside={inside_count}")
