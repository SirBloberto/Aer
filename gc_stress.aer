function garbage_burst(n):
    total = 0
    i = 0
    for i < n:
        s = "item_{i}"
        a = [i, i + 1, i + 2]
        d = {"x": i, "y": s}
        total += length(s) + length(a) + length(d)
        i += 1
    return total

persistent = []
i = 0
for i < 256:
    append(persistent, [])
    i += 1

j = 0
for j < 100000:
    idx = j % 256
    persistent[idx] = "young_{j}"
    j += 1

result = garbage_burst(300000)
print("Garbage burst total: {result}")
print("Persistent mutations: {j}")
