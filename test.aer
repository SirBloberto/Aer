import time

limit = 1000000
start = time.now()
primes = []
for i in 0..limit+1:
    append(primes, 0)
primes[0] = 1
primes[1] = 1
p = 2
for p * p <= limit:
    if primes[p] == 0:
        i = p * p
        for i <= limit:
            primes[i] = 1
            i += p
    p += 1
results = []
for i in 0..length(primes):
    if primes[i] == 0:
        append(results, i)
end = time.now()
elapsed = end - start
print("Calculation finished in {elapsed} seconds.")
