{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AER",
  "scopeName": "source.aer",
  "fileTypes": ["aer"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#triple-strings" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#struct-declaration" },
    { "include": "#function-declaration" },
    { "include": "#cast-type" },
    { "include": "#keywords" },
    { "include": "#booleans-and-null" },
    { "include": "#core-builtins" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.aer",
          "match": "#.*$"
        }
      ]
    },
    "triple-strings": {
      "name": "string.quoted.triple.aer",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.aer",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aer",
          "match": "\\\\[nt\\\\\"{]"
        },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.aer",
      "match": "(\\{)([A-Za-z_][A-Za-z0-9_]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.template-expression.begin.aer" },
        "2": { "name": "variable.other.interpolated.aer" },
        "3": { "name": "punctuation.definition.template-expression.end.aer" }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.aer",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.aer",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.aer",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.control.loop.aer",
          "match": "\\b(for|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.aer",
          "match": "\\b(return|defer)\\b"
        },
        {
          "name": "keyword.other.import.aer",
          "match": "\\b(import)\\b"
        },
        {
          "name": "keyword.control.membership.aer",
          "match": "\\b(in)\\b"
        },
        {
          "name": "keyword.operator.cast.aer",
          "match": "\\b(as)\\b"
        },
        {
          "name": "storage.type.struct.aer",
          "match": "\\b(struct)\\b"
        },
        {
          "name": "storage.type.function.aer",
          "match": "\\b(function)\\b"
        }
      ]
    },
    "booleans-and-null": {
      "patterns": [
        {
          "name": "constant.language.boolean.aer",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.aer",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "storage.type.struct.aer" },
        "2": { "name": "entity.name.type.struct.aer" },
        "3": { "name": "punctuation.section.block.begin.aer" }
      }
    },
    "function-declaration": {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "captures": {
        "1": { "name": "storage.type.function.aer" },
        "2": { "name": "entity.name.function.aer" },
        "3": { "name": "punctuation.section.parens.begin.aer" }
      }
    },
    "cast-type": {
      "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.operator.cast.aer" },
        "2": { "name": "support.type.aer" }
      }
    },
    "core-builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aer",
          "match": "\\b(print|length|append|delete|type|assert|panic)\\b(?=\\s*\\()"
        }
      ]
    },
    "function-call": {
      "comment": "Any identifier immediately followed by '(' that wasn't already claimed by core-builtins or function-declaration above it — a call to a user-defined or module function (translate(...), fib(...), math.sqrt's 'sqrt' part, etc.).",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
      "name": "entity.name.function.call.aer"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.aer",
          "match": "(\\+=|-=|\\*=|//=|/=|%=|<<=|>>=|&=|\\|=|\\^=)"
        },
        {
          "name": "keyword.operator.assignment.aer",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.aer",
          "match": "(\\|\\||&&|!)"
        },
        {
          "name": "keyword.operator.pipe.aer",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.aer",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.bitwise.aer",
          "match": "(<<|>>|~|\\^|&|\\|)"
        },
        {
          "name": "keyword.operator.range.aer",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.aer",
          "match": "(\\+|-|\\*|//|/|%)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.aer",
          "match": ","
        },
        {
          "name": "punctuation.accessor.aer",
          "match": "\\."
        },
        {
          "name": "punctuation.section.block.begin.aer",
          "match": ":"
        }
      ]
    },
    "variables": {
      "comment": "Catch-all, must stay last in the top-level patterns list — anything reaching here is a plain identifier (variable read/write, parameter, field name) that no more specific rule above already claimed.",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.readwrite.aer"
    }
  }
}
