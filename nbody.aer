PI = 3.14159265358979323
SOLAR_MASS = 4.0 * PI * PI
DAYS_PER_YEAR = 365.24

import math
import time

struct Body:
    x: float = 0.0
    y: float = 0.0
    z: float = 0.0
    vx: float = 0.0
    vy: float = 0.0
    vz: float = 0.0
    mass: float = 0.0

function offset_momentum(bodies):
    px, py, pz = 0.0, 0.0, 0.0
    num_bodies = length(bodies)
    for i in 0..num_bodies:
        px += bodies[i].vx * bodies[i].mass
        py += bodies[i].vy * bodies[i].mass
        pz += bodies[i].vz * bodies[i].mass

    bodies[0].vx = - px / SOLAR_MASS
    bodies[0].vy = - py / SOLAR_MASS
    bodies[0].vz = - pz / SOLAR_MASS


function energy(bodies):
    e = 0.0
    num_bodies = length(bodies)
    for i in 0..num_bodies:
        vx = bodies[i].vx
        vy = bodies[i].vy
        vz = bodies[i].vz
        bim = bodies[i].mass
        e += 0.5 * bim * (vx * vx + vy * vy + vz * vz)
        for j in (i+1)..num_bodies:
            dx = bodies[i].x - bodies[j].x
            dy = bodies[i].y - bodies[j].y
            dz = bodies[i].z - bodies[j].z
            sq = dx * dx + dy * dy + dz * dz
            e -= (bim * bodies[j].mass) / math.sqrt(sq)
    return e

# Body fields are hoisted into plain locals for the outer body i (bix/biy/biz/bimass/bivx/bivy/bivz)
# — same idiom as before, and still a real win: it turns O(n^2) struct-field traffic into a single
# O(n) read/write-back. A packed array has no standalone per-element reference (see the field's own
# design notes), so bj's fields are read directly via bodies[j].field inline in the inner loop
# instead of a hoisted alias — computationally identical either way, since a packed element's
# address is pure arithmetic (base + index * element_size), not a pointer dereference to save.
function advance(bodies, dt):
    num_bodies = length(bodies)
    for i in 0..num_bodies:
        bix = bodies[i].x
        biy = bodies[i].y
        biz = bodies[i].z
        bimass = bodies[i].mass
        bivx = bodies[i].vx
        bivy = bodies[i].vy
        bivz = bodies[i].vz
        for j in (i+1)..num_bodies:
            dx = bix - bodies[j].x
            dy = biy - bodies[j].y
            dz = biz - bodies[j].z
            dpos_norm_sq = dx * dx + dy * dy + dz * dz
            mag = dt / (dpos_norm_sq * math.sqrt(dpos_norm_sq))

            mj = bodies[j].mass * mag
            bivx -= dx * mj
            bivy -= dy * mj
            bivz -= dz * mj

            mi = bimass * mag
            bodies[j].vx += dx * mi
            bodies[j].vy += dy * mi
            bodies[j].vz += dz * mi
        bodies[i].vx = bivx
        bodies[i].vy = bivy
        bodies[i].vz = bivz

    for i in 0..num_bodies:
        bodies[i].x += bodies[i].vx * dt
        bodies[i].y += bodies[i].vy * dt
        bodies[i].z += bodies[i].vz * dt

bodies = Body[5]

bodies[0].mass = SOLAR_MASS

bodies[1].x = 4.84143144246472090e+00
bodies[1].y = -1.16032004402742839e+00
bodies[1].z = -1.03622044471123109e-01
bodies[1].vx = 1.66007664274403694e-03 * DAYS_PER_YEAR
bodies[1].vy = 7.69901118419740425e-03 * DAYS_PER_YEAR
bodies[1].vz = -6.90460016972063023e-05 * DAYS_PER_YEAR
bodies[1].mass = 9.54791938424326609e-04 * SOLAR_MASS

bodies[2].x = 8.34336671824457987e+00
bodies[2].y = 4.12479856412430479e+00
bodies[2].z = -4.03523417114321381e-01
bodies[2].vx = -2.76742510726862411e-03 * DAYS_PER_YEAR
bodies[2].vy = 4.99852801234917238e-03 * DAYS_PER_YEAR
bodies[2].vz = 2.30417297573763929e-05 * DAYS_PER_YEAR
bodies[2].mass = 2.85885980666130812e-04 * SOLAR_MASS

bodies[3].x = 1.28943695621391310e+01
bodies[3].y = -1.51111514016986312e+01
bodies[3].z = -2.23307578892655734e-01
bodies[3].vx = 2.96460137564761618e-03 * DAYS_PER_YEAR
bodies[3].vy = 2.37847173959480950e-03 * DAYS_PER_YEAR
bodies[3].vz = -2.96589568540237556e-05 * DAYS_PER_YEAR
bodies[3].mass = 4.36624404335156298e-05 * SOLAR_MASS

bodies[4].x = 1.53796971148509165e+01
bodies[4].y = -2.59193146099879641e+01
bodies[4].z = 1.79258772950371181e-01
bodies[4].vx = 2.68067772490389322e-03 * DAYS_PER_YEAR
bodies[4].vy = 1.62824170038242295e-03 * DAYS_PER_YEAR
bodies[4].vz = -9.51592254519715870e-05 * DAYS_PER_YEAR
bodies[4].mass = 5.15138902046611451e-05 * SOLAR_MASS

start = time.now()
offset_momentum(bodies)
a = energy(bodies)
for i in 0..500000:
    advance(bodies, 0.01)
a = energy(bodies)
dur = time.now() - start
print("Took: {dur}s")
