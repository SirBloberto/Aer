/* One row per opcode, in wire order: OPCODE(name, handler, doubled slot fields, description, operand
   layout). vm.h expands it into the Opcode enum and op_scaled_fields, handlers.c into the dispatch table, and
   disasm.c, which defines the L_* layouts, into the operand table. A `none` handler is a parser tag. */

/* Binary arithmetic */
OPCODE(ADD, add, 0, "reg = rk + rk", L_BINOP)
OPCODE(SUB, sub, 0, "reg = rk - rk", L_BINOP)
OPCODE(MUL, mul, 0, "reg = rk * rk", L_BINOP)
OPCODE(DIV, div, 0, "reg = rk / rk", L_BINOP)
OPCODE(MOD, mod, 0, "reg = rk % rk", L_BINOP)
OPCODE(FLOOR_DIV, floor_div, 0, "reg = rk // rk", L_BINOP)

/* Binary comparison */
OPCODE(EQ, eq, 0, "reg = rk == rk", L_BINOP)
OPCODE(NEQ, neq, 0, "reg = rk != rk", L_BINOP)
OPCODE(LT, lt, 0, "reg = rk < rk", L_BINOP)
OPCODE(GT, gt, 0, "reg = rk > rk", L_BINOP)
OPCODE(LTE, lte, 0, "reg = rk <= rk", L_BINOP)
OPCODE(GTE, gte, 0, "reg = rk >= rk", L_BINOP)
/* key in dict → key existence; value in array → element scan */
OPCODE(IN, in, 0, "reg = rk in rk", L_BINOP)

/* Never dispatched -- parser tags for `&&`/`||`, which compile to short-circuit jumps. */
OPCODE(AND, none, 0, "")
OPCODE(OR, none, 0, "")
/* also never dispatched -- `x |> f(args)` desugars to a call at parse time */
OPCODE(PIPE, none, 0, "")

/* Binary bitwise */
OPCODE(BITWISE_AND, bitwise_and, 0, "reg = rk & rk", L_BINOP)
OPCODE(BITWISE_OR, bitwise_or, 0, "reg = rk | rk", L_BINOP)
OPCODE(BITWISE_XOR, bitwise_xor, 0, "reg = rk ^ rk", L_BINOP)
OPCODE(LSHIFT, lshift, 0, "reg = rk << rk", L_BINOP)
OPCODE(RSHIFT, rshift, 0, "reg = rk >> rk", L_BINOP)

/* Unary */
OPCODE(NEGATE, none, 0, "")
OPCODE(NOT, none, 0, "")
OPCODE(BITWISE_NOT, none, 0, "")

/* OP_JUMP's handler only touches vm->ip, so register opcodes reuse it for unconditional jumps.
   operand: absolute code index */
OPCODE(JUMP, jump, 0, "unconditional jump", {AT_W1, F_JUMP})

/* Struct definitions only -- instantiation/field access are register opcodes below.
   name idx, field count, then that many (name, default) pairs */
OPCODE(DEFINE_STRUCT, define_struct, 0,
       "register a struct type (variable-length: header word, then that many field words)", L_VARIABLE)

/* Misc
   an OP_UNARY tag, not dispatched alone -- see vm_to_str() */
OPCODE(TO_STR, none, 0, "")
OPCODE(HALT, halt, 0, "stop execution")

/* operands: dest_reg, pool_idx -- registers[dest_reg] = chunk pool constant */
OPCODE(LOADK, loadk, SCALED_A, "reg = pool constant", {AT_A, F_REG}, {AT_W16, F_POOL})
/* operands: dest_reg, src_reg -- registers[dest_reg] = registers[src_reg] */
OPCODE(MOVE, move, SCALED_A | SCALED_B, "reg = reg", {AT_A, F_REG}, {AT_B, F_REG})
/* dest_reg, src_reg -- dest = (src is a Result); gates |>'s short-circuit (compile_pipe). */
OPCODE(IS_RESULT, is_result, 0, "reg = is-result(reg)", {AT_A, F_REG}, {AT_B, F_REG})

/* Condition is read straight from a register/RK constant, never popped.
   operands: reg, target -- jump to target if registers[reg] is falsy */
OPCODE(JUMP_IF_FALSE_REG, jump_if_false_reg, SCALED_A, "jump if !reg, no pop", {AT_A, F_REG}, {AT_W1, F_JUMP})

/* Calls -- per-call register windowing (CallFrame): each call gets an isolated bank.
   dest_reg, callee_offset, arg_reg_base, arg_count -- copies args into the callee frame, saves return address
   + dest, jumps */
OPCODE(CALL, call, 0, "call by compile-time-resolved offset", L_CALL)
/* src_reg (callee frame) -- result to caller's dest_reg, pops the frame, jumps back */
OPCODE(RETURN, return, 0, "return reg to caller", {AT_A, F_REG})

/* Call through a runtime function value in a register; fills omitted trailing args from defaults.
   dest_reg, arg_reg_base, arg_count, callee_reg */
OPCODE(CALL_VALUE, call_value, 0, "call a runtime function value held in a register", L_CALL_VALUE)

/* `return f(args)` with nothing wrapping the call: the already-emitted OP_CALL word's opcode
   byte is patched in place. Same dispatch label as OP_CALL; overwrites the CURRENT frame's
   registers[0..arg_count) (arg registers are always temps, above any local) and jumps --
   call_depth/dest_reg/return_ip stay untouched.
   same operands as OP_CALL; dest_reg is unused (ignored) here */
OPCODE(TAIL_CALL, tail_call, 0, "tail call by compile-time-resolved offset, reuses this frame", L_CALL)
/* same operands as OP_CALL_VALUE; dest_reg is unused (ignored) here */
OPCODE(TAIL_CALL_VALUE, call_value, 0, "tail call through a register value, reuses this frame", L_CALL_VALUE)

/* Bridges to the stack-based stdlib dispatch, stack-neutral. Trailing words carry the
   parse-time-resolved module_id and fn_id; CALL_MODULE_DYNAMIC resolves by name at runtime. */
OPCODE(CALL_MODULE, call_module, 0,
       "call a native or file-module function by (module, function) name",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT}, {AT_W1, F_NAME}, {AT_W2, F_NAME},
       {AT_W3_HI, F_MODULE_ID}, {AT_W3_LO, F_MODULE_FN})

/* Bare global builtins (length/print/type/assert/panic/Result): bridges to vm_call_builtin()
   via a small local array. Trailing word: builtin_id.
   operands: dest_reg, name_pool_idx, arg_reg_base, arg_count, builtin_id */
OPCODE(CALL_BUILTIN, call_builtin, 0,
       "global builtin (length/print/etc.) by name",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT}, {AT_W1, F_NAME}, {AT_W2, F_BUILTIN_ID})

/* Registers can hold heap values -- mark_vm_roots scans all of registers[] per live frame.
   dest_reg, item_reg_base, item_count */
OPCODE(ARRAY_NEW, array_new, 0,
       "reg = new array from a contiguous reg range", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT})
/* dest_reg, arr_reg, rk_idx -- via vm_index_get_compute */
OPCODE(INDEX_GET, index_get, SCALED_A | SCALED_B,
       "reg = reg[rk]", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_RK8})
/* arr_reg, rk_idx, rk_val -- via vm_index_set_compute (includes the write barrier) */
OPCODE(INDEX_SET, index_set, SCALED_A, "reg[rk] = rk", {AT_A, F_REG}, {AT_B, F_RK8}, {AT_C, F_RK8})

/* Typed-array-only OP_INDEX_GET/SET, same word layout, emitted only where index_safe_unchecked
   (parser.c) proved the index in range for the whole enclosing loop. elem_kind is read at
   runtime from the array, so one opcode covers every element kind. The TYPE_TYPED_ARRAY tag is
   still checked -- only the index-range half of the safety argument is a compile-time fact.
   dest_reg, arr_reg, rk_idx */
OPCODE(TYPED_INDEX_GET_UNCHECKED, typed_index_get_unchecked, SCALED_A | SCALED_B,
       "loop-proven-safe: reg = typed_arr[rk]", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_RK8})
/* arr_reg, rk_idx, rk_val */
OPCODE(TYPED_INDEX_SET_UNCHECKED, typed_index_set_unchecked, SCALED_A,
       "loop-proven-safe: typed_arr[rk] = rk", {AT_A, F_REG}, {AT_B, F_RK8}, {AT_C, F_RK8})

/* `a, b = expr`: Result/array unpacks normally, anything else becomes (value, null).
   target0_reg, target1_reg, src_reg */
OPCODE(DESTRUCTURE, destructure, 0,
       "reg, reg = destructure(reg)", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_REG})

/* Slicing (array or string); a missing bound compiles to an RK null constant.
   dest_reg, arr_reg, rk_start, rk_end */
OPCODE(SLICE_GET, slice_get, 0,
       "reg = reg[rk:rk]", {AT_A, F_REG}, {AT_B, F_REG}, {AT_W1_HI, F_RK16}, {AT_W1_LO, F_RK16})

/* OP_ARRAY_NEW's bulk-copy applied to (key,val) register pairs; same key validation and
   owned-key discipline as stack dict construction.
   dest_reg, pair_reg_base, pair_count -- key at base+2*i, val at +2*i+1 */
OPCODE(DICT_NEW, dict_new, 0,
       "reg = new dict from contiguous key/value reg pairs", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT})

/* Single-variable iteration; break is a plain jump, no cleanup needed.
   col_reg, idx_reg, item_dest_reg, end_target -- despite the name, also accepts a dict (yields keys) or
   string (yields chars) */
OPCODE(ITER_NEXT_ARRAY, iter_next_array, 0,
       "for-each step, array or dict-keys", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_REG}, {AT_W1, F_JUMP})

/* Dict-only two-variable form; val_dest_reg needs its own word (only 3 narrow fields pack).
   col, idx, key_dest, val_dest, end_target; key is freshly owned */
OPCODE(ITER_NEXT_PAIR, iter_next_pair, 0, "for-each step, dict key+value pairs", L_ITER)

/* Rotated range-for (Lua's FORLOOP shape): PREP runs once before the loop and LOOP, at its bottom, is
   the back-edge. PREP checks cur/end/step are ints (the only check), turns end/step into a countdown and a
   signed step, and jumps to empty_target when the count is zero. Safe only because cur/end/step are
   loop-owned snapshots (arg_materialize), never aliases, so LOOP never re-validates their types. */
OPCODE(ITER_RANGE_PREP, iter_range_prep, 0, "rotated range-for: once-before-loop check", L_ITER)
/* cur, remaining (was end), signed_step (was step), item_dest, body_target (already-resolved address) --
   countdown 0: fall through to the exit; else advance cur/item_dest, decrement, branch back to body_target */
OPCODE(ITER_RANGE_LOOP, iter_range_loop, SCALED_A | SCALED_B | SCALED_C,
       "rotated range-for: bottom-of-loop advance+check+branch-back (bounds snapshotted "
       "once, never re-validated)",
       L_ITER)

/* Instantiation/field get/set need register operands (definitions reuse OP_DEFINE_STRUCT).
   dest_reg, type_name_pool_idx, arg_reg_base, arg_count -- arity-checked, trailing fields default-filled */
OPCODE(STRUCT_NEW, struct_new, 0,
       "reg = new struct instance from a contiguous reg range",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT}, {AT_W1, F_NAME})
/* dest_reg, struct_reg, field_name_pool_idx */
OPCODE(FIELD_GET, field_get, 0, "reg = struct.field", {AT_A, F_REG}, {AT_B, F_REG}, {AT_W1, F_NAME})
/* struct_reg, field_name_pool_idx, rk_val -- includes the gc_barrier_array call */
OPCODE(FIELD_SET, field_set, 0, "struct.field = rk", {AT_A, F_REG}, {AT_W16, F_RK16}, {AT_W1, F_NAME})

/* `[value; count]` repeat-literal. Evaluates the fill expression once into fill_reg, then
   branches on its runtime type: TYPE_STRUCT builds a packed array copying that instance's own
   field values, TYPE_INTEGER/TYPE_REAL builds a typed array, anything else is a runtime error.
   narrow_flag (0 none, 1 int32, 2 float32) is parse-time only -- set solely when the fill was
   written as an `i`/`f` suffixed literal in this position, never derived from a runtime value.
   word0: dest_reg, fill_reg, narrow_flag -- word1: rk_count (RK16) */
OPCODE(ARRAY_REPEAT, array_repeat, 0,
       "reg = [fill_reg; rk_count] (struct -> packed array, number -> typed array)",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT}, {AT_W1_LO, F_RK16})

/* Fused `obj[index].field` get/set -- packed arrays have no standalone element reference, so
   the parser emits these only for the exact `expr[index].field` pattern.
   operands: dest_reg, obj_reg, field_name_pool_idx, rk_idx */
OPCODE(INDEX_FIELD_GET, index_field_get, 0,
       "fused: reg = reg[rk].field (packed or struct array)",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_W1_HI, F_NAME}, {AT_W1_LO, F_RK16})
/* operands: obj_reg, field_name_pool_idx, rk_idx, rk_val */
OPCODE(INDEX_FIELD_SET, index_field_set, 0,
       "fused: reg[rk].field = rk (packed or struct array)",
       {AT_A, F_REG}, {AT_W16, F_RK16}, {AT_W1_HI, F_NAME}, {AT_W1_LO, F_RK16})

/* `obj[index].field OP= rk_rhs` -- resolves the index+field exactly once, where a separate read
   and write each resolve it. The pattern nbody-style code hits constantly
   (`bodies[j].vx += dx * mi`).
   operands: obj_reg, field_name_pool_idx, rk_idx, bin_op, rk_rhs */
OPCODE(INDEX_FIELD_COMPOUND, index_field_compound, 0,
       "fused: reg[rk].field OP= rk (resolved once, packed or struct array)",
       {AT_A, F_REG}, {AT_B, F_BINOP}, {AT_W1_HI, F_NAME}, {AT_W1_LO, F_RK16}, {AT_W2_LO, F_RK16})

/* unary_op reuses OP_NEGATE/OP_NOT/OP_BITWISE_NOT/OP_TO_STR as its tag, like bin_op.
   dest_reg, unary_op, rk_operand -- also folds OP_TO_STR (interpolation) via vm_to_str */
OPCODE(UNARY, unary, 0, "reg = unary_op(rk)", {AT_A, F_REG}, {AT_B, F_BINOP}, {AT_C, F_RK8})

/* integer(x)/float(x)/boolean(x) via vm_cast; string(x) is OP_UNARY's TO_STR instead (see
   emit_primitive_cast, parser.c) -- struct shape-checking is type(x) == "Name", no opcode
   of its own needed.
   dest_reg, cast_type, rk_operand */
OPCODE(CAST, cast, 0, "reg = cast(rk)", {AT_A, F_REG}, {AT_B, F_CAST}, {AT_C, F_RK8})

/* One opcode for both argument orders of `x OP y.field`. parse_binary_ops truncates the
   just-emitted OP_FIELD_GET, re-encodes it here, and canonicalizes the operator so the field is
   always the left operand -- free for the 11 commutative-or-flippable operators. The 7
   order-sensitive ones don't fuse in that order at all.
   dest_reg, struct_reg, field_name_pool_idx, bin_op, rk_rhs */
OPCODE(FIELD_BINARY, field_binary, 0,
       "fused: reg = struct.field OP rk (field on the left)",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_BINOP}, {AT_W1_HI, F_NAME}, {AT_W1_LO, F_RK16})

/* `struct.field OP= rhs` -- reads, computes and writes back in one dispatch and one
   vm_resolve_field call, where a separate read and write cost two inline-cache lookups for one
   logical operation. Same operand shape as OP_FIELD_BINARY (dest slot unused).
   struct_reg, field_name_pool_idx, bin_op, rk_rhs */
OPCODE(FIELD_COMPOUND, field_compound, 0,
       "fused: struct.field OP= rk (resolved once, no dest reg)",
       {AT_A, F_REG}, {AT_B, F_BINOP}, {AT_W1_HI, F_NAME}, {AT_W1_LO, F_RK16})

/* `arr[rk] OP= rhs` for every receiver the raw forms do not cover -- a dict, a plain array, a
   narrow element. One dispatch and, for a dict, one hash instead of the two a separate read and
   write pay. The element counterpart of OP_FIELD_COMPOUND above, which a tally (`counts[k] += 1`)
   needs as often as a struct field does.
   word0: arr_reg, bin_op -- word1: rk_idx(hi16)/rk_rhs(lo16) */
OPCODE(INDEX_COMPOUND, index_compound, 0,
       "fused: arr[rk] OP= rk (any receiver, no dest reg)",
       {AT_A, F_REG}, {AT_B, F_BINOP}, {AT_W1_HI, F_RK16}, {AT_W1_LO, F_RK16})

/* Fuses `(A op1 B) op2 C` written as one expression: parse_binary_ops truncates the inner op and
   re-encodes it alongside op2/C. Fuses only when A/B/C turn out to be matching typed arrays at
   runtime; anything else computes the same value unfused.
   dest_reg, a_reg, b_reg; word1: op1(hi16)/c_reg(lo16); word2: op2 */
OPCODE(TYPED_ARRAY_CHAIN2, typed_array_chain2, 0,
       "fused: reg = (reg op1 reg) op2 reg (typed-array chain, runtime-checked)",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_REG}, {AT_W1_HI, F_BINOP}, {AT_W1_LO, F_REG}, {AT_W2, F_BINOP})

/* Shell mode: a bare statement's non-null result is printed.
   operand: src_reg -- prints registers[src_reg] unless it's TYPE_NULL */
OPCODE(PRINT_REPL, print_repl, 0, "shell mode: print reg unless null", {AT_A, F_REG})

/* Unchecked arithmetic on provably-monotype locals; operands are plain register indices, no RK
   encoding. Each writes a fully tagged AerVal, so the result needs no conversion to be read by
   any other opcode -- "raw" names the checks skipped, not a separate place to live. */
OPCODE(RAW_LOAD_INT, raw_load_int, SCALED_A, "rawi = imm (full int32)", {AT_A, F_RAWI}, {AT_W1, F_IMM32})
OPCODE(RAW_LOAD_REAL, raw_load_real, SCALED_A, "rawr = pool constant", {AT_A, F_RAWR}, {AT_W1, F_POOL_RAWD})
OPCODE(RAW_ADD_INT, raw_add_int, SCALED_A | SCALED_B | SCALED_C,
       "rawi = rawi + rawi", L_RAW_ARITH(F_RAWI, F_RAWK_I))
OPCODE(RAW_SUB_INT, raw_sub_int, SCALED_A | SCALED_B | SCALED_C,
       "rawi = rawi - rawi", L_RAW_ARITH(F_RAWI, F_RAWK_I))
OPCODE(RAW_MUL_INT, raw_mul_int, SCALED_A | SCALED_B | SCALED_C,
       "rawi = rawi * rawi", L_RAW_ARITH(F_RAWI, F_RAWK_I))
/* Literal right operand read straight from rawk_i, no OP_RAW_LOAD_INT and no slot. Separate
   opcodes rather than a const flag on the two above, because testing that flag costs every
   iteration of every numeric loop while the load it saves is one a loop preheader already
   hoists. These earn their keep only where there is no preheader: a function body, re-entered
   per call. */
OPCODE(RAW_ADD_INT_K, raw_add_int_k, SCALED_A | SCALED_B,
       "rawi = rawi + rawk", L_RAW_ARITH(F_RAWI, F_RAWK_I_AT))
OPCODE(RAW_SUB_INT_K, raw_sub_int_k, SCALED_A | SCALED_B,
       "rawi = rawi - rawk", L_RAW_ARITH(F_RAWI, F_RAWK_I_AT))
OPCODE(RAW_DIV_INT, raw_div_int, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawi / rawi (int/int division always promotes to real)",
       {AT_A, F_RAWR}, {AT_B, F_RAWI}, {AT_C, F_RAWK_I})
OPCODE(RAW_MOD_INT, raw_mod_int, SCALED_A | SCALED_B | SCALED_C,
       "rawi = rawi % rawi", L_RAW_ARITH(F_RAWI, F_RAWK_I))
OPCODE(RAW_FLOOR_DIV_INT, raw_floor_div_int, SCALED_A | SCALED_B | SCALED_C,
       "rawi = floor(rawi / rawi)", L_RAW_ARITH(F_RAWI, F_RAWK_I))
OPCODE(RAW_ADD_REAL, raw_add_real, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawr + rawr", L_RAW_ARITH(F_RAWR, F_RAWK_D))
OPCODE(RAW_SUB_REAL, raw_sub_real, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawr - rawr", L_RAW_ARITH(F_RAWR, F_RAWK_D))
OPCODE(RAW_MUL_REAL, raw_mul_real, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawr * rawr", L_RAW_ARITH(F_RAWR, F_RAWK_D))
OPCODE(RAW_DIV_REAL, raw_div_real, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawr / rawr", L_RAW_ARITH(F_RAWR, F_RAWK_D))
/* `x += a*b` / `x -= a*b` on raw real locals, in place, collapsing the RHS's MUL and this ADD/SUB
   into one dispatch. Still two roundings, not a hardware FMA, so results are bit-identical to
   the unfused pair -- only a dispatch is removed. */
OPCODE(RAW_FMA_REAL, raw_fma_real, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawr + rawr * rawr (fused mul-add dispatch, two roundings)", L_RAW_ARITH(F_RAWR, F_RAWK_D))
OPCODE(RAW_FMS_REAL, raw_fms_real, SCALED_A | SCALED_B | SCALED_C,
       "rawr = rawr - rawr * rawr (fused mul-sub dispatch, two roundings)", L_RAW_ARITH(F_RAWR, F_RAWK_D))
OPCODE(RAW_LT_INT, raw_lt_int, SCALED_A | SCALED_B, "reg = rawi < rawi", L_RAW_CMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_LTE_INT, raw_lte_int, SCALED_A | SCALED_B, "reg = rawi <= rawi", L_RAW_CMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_LT_REAL, raw_lt_real, SCALED_A | SCALED_B, "reg = rawr < rawr", L_RAW_CMP(F_RAWR, F_RAWK_D))
OPCODE(RAW_LTE_REAL, raw_lte_real, SCALED_A | SCALED_B, "reg = rawr <= rawr", L_RAW_CMP(F_RAWR, F_RAWK_D))
/* Equality has no ordering to flip, so unlike GT/GTE it cannot fold into another member -- and
   without it a raw value that only ever gets compared (`flags[p] == 0`) was boxed purely to
   reach the general comparison. */
OPCODE(RAW_EQ_INT, raw_eq_int, SCALED_A | SCALED_B, "reg = rawi == rawi", L_RAW_CMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_NEQ_INT, raw_neq_int, SCALED_A | SCALED_B, "reg = rawi != rawi", L_RAW_CMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_EQ_REAL, raw_eq_real, SCALED_A | SCALED_B, "reg = rawr == rawr", L_RAW_CMP(F_RAWR, F_RAWK_D))
OPCODE(RAW_NEQ_REAL, raw_neq_real, SCALED_A | SCALED_B, "reg = rawr != rawr", L_RAW_CMP(F_RAWR, F_RAWK_D))
/* The one remaining bridge: a slot whose type nothing has proven, checked once so everything
   after it is unchecked arithmetic. UNBOX_REAL takes an integer too, matching what the checked
   arithmetic would have done. There is no opcode for the other direction -- an unchecked opcode
   already leaves a fully tagged value behind. */
OPCODE(UNBOX_INT, unbox_int, SCALED_A | SCALED_B,
       "rawi = unbox(reg) (tag-checked)", {AT_A, F_RAWI}, {AT_B, F_REG})
OPCODE(UNBOX_REAL, unbox_real, SCALED_A | SCALED_B,
       "rawr = unbox(reg) (tag-checked)", {AT_A, F_RAWR}, {AT_B, F_REG})
OPCODE(RAW_MOVE_INT, raw_move_int, SCALED_A | SCALED_B, "rawi = rawi", {AT_A, F_RAWI}, {AT_B, F_RAWI})
OPCODE(RAW_MOVE_REAL, raw_move_real, SCALED_A | SCALED_B, "rawr = rawr", {AT_A, F_RAWR}, {AT_B, F_RAWR})
/* For the rare literal that does not fit OP_RAW_LOAD_INT's int32 immediate. */
OPCODE(RAW_LOAD_INT_POOL, raw_load_int_pool, SCALED_A,
       "rawi = pool constant", {AT_A, F_RAWI}, {AT_W1, F_POOL_RAWI})

/* Shape-specialized field access -- only ever emitted into a ChunkFunction's SPECIALIZED body
   (see ChunkFunction.specializations below), where the compiler has proven (via a runtime shape
   observed at a call site, then substituted in as compile-time-known for one recompile) which
   Shape a parameter has. The field's byte offset is then a compile-time constant -- no
   vm_resolve_field_by_shape call, no boxed AerVal ever constructed. Never appears in a
   function's ordinary (generic, always-present) body. */
OPCODE(INDEX_FIELD_GET_RAW_INT, index_field_get_raw_int, 0,
       "specialized: rawi = packed_arr[rk].field", L_IDX_FIELD_GET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_GET_RAW_REAL, index_field_get_raw_real, 0,
       "specialized: rawr = packed_arr[rk].field", L_IDX_FIELD_GET_RAW(F_RAWR))
OPCODE(FIELD_GET_RAW_INT, field_get_raw_int, 0, "specialized: rawi = struct.field", L_FIELD_GET_RAW(F_RAWI))
OPCODE(FIELD_GET_RAW_REAL, field_get_raw_real, 0, "specialized: rawr = struct.field", L_FIELD_GET_RAW(F_RAWR))
OPCODE(INDEX_FIELD_SET_RAW_INT, index_field_set_raw_int, 0,
       "specialized: packed_arr[rk].field = rawi", L_IDX_FIELD_SET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_SET_RAW_REAL, index_field_set_raw_real, 0,
       "specialized: packed_arr[rk].field = rawr", L_IDX_FIELD_SET_RAW(F_RAWR))
OPCODE(FIELD_SET_RAW_INT, field_set_raw_int, 0, "specialized: struct.field = rawi", L_FIELD_SET_RAW(F_RAWI))
OPCODE(FIELD_SET_RAW_REAL, field_set_raw_real, 0, "specialized: struct.field = rawr", L_FIELD_SET_RAW(F_RAWR))
/* Compound assignment whose RHS already resolved to a raw value: reads the field raw, applies
   the op against the raw rhs, writes back raw, in one dispatch with neither side boxed and no
   runtime field lookup. ADD/SUB/MUL only; /=, %=, //= fall back to the generic opcode. */
OPCODE(FIELD_COMPOUND_RAW_INT, field_compound_raw_int, 0,
       "specialized: struct.field OP= rawi", L_FIELD_COMPOUND_RAW(F_RAWI))
OPCODE(FIELD_COMPOUND_RAW_REAL, field_compound_raw_real, 0,
       "specialized: struct.field OP= rawr", L_FIELD_COMPOUND_RAW(F_RAWR))
OPCODE(INDEX_FIELD_COMPOUND_RAW_INT, index_field_compound_raw_int, 0,
       "specialized: packed_arr[rk].field OP= rawi", L_IDX_FIELD_COMPOUND_RAW(F_RAWI))
OPCODE(INDEX_FIELD_COMPOUND_RAW_REAL, index_field_compound_raw_real, 0,
       "specialized: packed_arr[rk].field OP= rawr", L_IDX_FIELD_COMPOUND_RAW(F_RAWR))

/* _UNCHECKED counterparts of the INDEX_FIELD_*_RAW_INT/REAL opcodes above: same compile-time
   offset, but skip vm_packed_raw_elem's index-type, negative-adjust, bounds and null checks.
   Emitted only where the index is provably a `for i in 0..n:` loop variable with n proven ==
   length(this same array) and unreassigned. Shape is still guarded by reg_known_shape, so only
   the index-safety half is removed. */
OPCODE(INDEX_FIELD_GET_RAW_INT_UNCHECKED, index_field_get_raw_int_unchecked, 0,
       "specialized+loop-proven-safe: rawi = packed_arr[rk].field", L_IDX_FIELD_GET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_GET_RAW_REAL_UNCHECKED, index_field_get_raw_real_unchecked, 0,
       "specialized+loop-proven-safe: rawr = packed_arr[rk].field", L_IDX_FIELD_GET_RAW(F_RAWR))
OPCODE(INDEX_FIELD_SET_RAW_INT_UNCHECKED, index_field_set_raw_int_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field = rawi", L_IDX_FIELD_SET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_SET_RAW_REAL_UNCHECKED, index_field_set_raw_real_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field = rawr", L_IDX_FIELD_SET_RAW(F_RAWR))
OPCODE(INDEX_FIELD_COMPOUND_RAW_INT_UNCHECKED, index_field_compound_raw_int_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field OP= rawi", L_IDX_FIELD_COMPOUND_RAW(F_RAWI))
OPCODE(INDEX_FIELD_COMPOUND_RAW_REAL_UNCHECKED, index_field_compound_raw_real_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field OP= rawr", L_IDX_FIELD_COMPOUND_RAW(F_RAWR))

/* Narrow (int32/float32) counterparts of the raw field-access family: storage is 4 bytes, but the
   compute side is unchanged -- values widen into ordinary raw slots on read and narrow on write,
   so every raw arithmetic opcode is untouched. Unlike the boxed path these do not range-check on
   overflow, matching the "raw means unchecked" tradeoff every other raw opcode makes. */
OPCODE(INDEX_FIELD_GET_RAW_INT32, index_field_get_raw_int32, 0,
       "specialized: rawi = packed_arr[rk].field (narrow)", L_IDX_FIELD_GET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_GET_RAW_FLOAT32, index_field_get_raw_float32, 0,
       "specialized: rawr = packed_arr[rk].field (narrow)", L_IDX_FIELD_GET_RAW(F_RAWR))
OPCODE(FIELD_GET_RAW_INT32, field_get_raw_int32, 0,
       "specialized: rawi = struct.field (narrow)", L_FIELD_GET_RAW(F_RAWI))
OPCODE(FIELD_GET_RAW_FLOAT32, field_get_raw_float32, 0,
       "specialized: rawr = struct.field (narrow)", L_FIELD_GET_RAW(F_RAWR))
OPCODE(INDEX_FIELD_SET_RAW_INT32, index_field_set_raw_int32, 0,
       "specialized: packed_arr[rk].field = rawi (narrow)", L_IDX_FIELD_SET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_SET_RAW_FLOAT32, index_field_set_raw_float32, 0,
       "specialized: packed_arr[rk].field = rawr (narrow)", L_IDX_FIELD_SET_RAW(F_RAWR))
OPCODE(FIELD_SET_RAW_INT32, field_set_raw_int32, 0,
       "specialized: struct.field = rawi (narrow)", L_FIELD_SET_RAW(F_RAWI))
OPCODE(FIELD_SET_RAW_FLOAT32, field_set_raw_float32, 0,
       "specialized: struct.field = rawr (narrow)", L_FIELD_SET_RAW(F_RAWR))
OPCODE(FIELD_COMPOUND_RAW_INT32, field_compound_raw_int32, 0,
       "specialized: struct.field OP= rawi (narrow)", L_FIELD_COMPOUND_RAW(F_RAWI))
OPCODE(FIELD_COMPOUND_RAW_FLOAT32, field_compound_raw_float32, 0,
       "specialized: struct.field OP= rawr (narrow)", L_FIELD_COMPOUND_RAW(F_RAWR))
OPCODE(INDEX_FIELD_COMPOUND_RAW_INT32, index_field_compound_raw_int32, 0,
       "specialized: packed_arr[rk].field OP= rawi (narrow)", L_IDX_FIELD_COMPOUND_RAW(F_RAWI))
OPCODE(INDEX_FIELD_COMPOUND_RAW_FLOAT32, index_field_compound_raw_float32, 0,
       "specialized: packed_arr[rk].field OP= rawr (narrow)", L_IDX_FIELD_COMPOUND_RAW(F_RAWR))

/* _UNCHECKED counterparts of the narrow INDEX_FIELD_*_RAW_INT32/FLOAT32 opcodes above -- same
   relationship the wide _UNCHECKED family (above) has to its own checked counterparts: only
   the index-safety half of vm_packed_raw_elem's checks is skipped, gated behind the exact same
   index_safe_unchecked proof, narrow storage width unaffected. */
OPCODE(INDEX_FIELD_GET_RAW_INT32_UNCHECKED, index_field_get_raw_int32_unchecked, 0,
       "specialized+loop-proven-safe: rawi = packed_arr[rk].field (narrow)", L_IDX_FIELD_GET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_GET_RAW_FLOAT32_UNCHECKED, index_field_get_raw_float32_unchecked, 0,
       "specialized+loop-proven-safe: rawr = packed_arr[rk].field (narrow)", L_IDX_FIELD_GET_RAW(F_RAWR))
OPCODE(INDEX_FIELD_SET_RAW_INT32_UNCHECKED, index_field_set_raw_int32_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field = rawi (narrow)", L_IDX_FIELD_SET_RAW(F_RAWI))
OPCODE(INDEX_FIELD_SET_RAW_FLOAT32_UNCHECKED, index_field_set_raw_float32_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field = rawr (narrow)", L_IDX_FIELD_SET_RAW(F_RAWR))
OPCODE(INDEX_FIELD_COMPOUND_RAW_INT32_UNCHECKED, index_field_compound_raw_int32_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field OP= rawi (narrow)",
       L_IDX_FIELD_COMPOUND_RAW(F_RAWI))
OPCODE(INDEX_FIELD_COMPOUND_RAW_FLOAT32_UNCHECKED, index_field_compound_raw_float32_unchecked, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field OP= rawr (narrow)",
       L_IDX_FIELD_COMPOUND_RAW(F_RAWR))

/* `+=` on a loop-proven packed element skips the bin_op switch every opcode above runs, since
   bin_op is compile-time known. Only these two shapes: every other width and checked-ness was
   measured at under 400 dispatches across the whole benchmark corpus, where the switch costs
   nothing and the extra opcode costs every other opcode BTB pressure. */
OPCODE(INDEX_FIELD_COMPOUND_RAW_REAL_UNCHECKED_ADD, index_field_compound_raw_real_unchecked_add, 0,
       "specialized: field += raw", L_IDX_FIELD_COMPOUND_RAW(F_RAWR))
OPCODE(INDEX_FIELD_COMPOUND_RAW_FLOAT32_UNCHECKED_ADD, index_field_compound_raw_float32_unchecked_add, 0,
       "specialized: field += raw", L_IDX_FIELD_COMPOUND_RAW(F_RAWR))

/* `field += a*b`: the same fusion OP_RAW_FMA_REAL does for raw locals, which excludes field
   destinations, so the two benchmarks that spend a fifth of their dispatches on exactly this
   shape paid a separate OP_RAW_MUL_REAL for it. Two roundings, not a hardware FMA, so results
   match the unfused pair. Only the two storage kinds that carry real traffic; every other
   field kind keeps the unfused MUL + COMPOUND pair.
   word0 = PACK3(op, obj_reg, mul_a, mul_b); word1 = foffset, or PACK_2X16(foffset, rk_idx). */
OPCODE(FIELD_COMPOUND_RAW_FLOAT32_FMA, field_compound_raw_float32_fma, 0,
       "specialized: struct.field += rawr * rawr (narrow)",
       {AT_A, F_REG}, {AT_B, F_RAWR}, {AT_C, F_RAWR}, {AT_W1, F_OFF})
OPCODE(INDEX_FIELD_COMPOUND_RAW_REAL_UNCHECKED_FMA, index_field_compound_raw_real_unchecked_fma, 0,
       "specialized+loop-proven-safe: packed_arr[rk].field += rawr * rawr",
       {AT_A, F_REG}, {AT_B, F_RAWR}, {AT_C, F_RAWR}, {AT_W1_HI, F_OFF}, {AT_W1_LO, F_RK16})

/* A bare comparison forming an entire if/while condition collapses with its
   OP_JUMP_IF_FALSE_REG into one dispatch -- the boolean was only ever read once, immediately.
   Only the 6 plain boxed comparisons (raw ones have faster opcodes already) and only when
   nothing else is emitted around the comparison; anything wrapped falls back unfused.
   word0 = PACK3(op, unused, rk_lhs8, rk_rhs8); word1 = jump target. */
OPCODE(EQ_JUMP_IF_FALSE, eq_jump_if_false, 0, "jump if !(rk == rk)", L_CMP_JUMP)
OPCODE(NEQ_JUMP_IF_FALSE, neq_jump_if_false, 0, "jump if !(rk != rk)", L_CMP_JUMP)
OPCODE(LT_JUMP_IF_FALSE, lt_jump_if_false, 0, "jump if !(rk < rk)", L_CMP_JUMP)
OPCODE(GT_JUMP_IF_FALSE, gt_jump_if_false, 0, "jump if !(rk > rk)", L_CMP_JUMP)
OPCODE(LTE_JUMP_IF_FALSE, lte_jump_if_false, 0, "jump if !(rk <= rk)", L_CMP_JUMP)
OPCODE(GTE_JUMP_IF_FALSE, gte_jump_if_false, 0, "jump if !(rk >= rk)", L_CMP_JUMP)

/* The same fusion with both operands unchecked. No GT/GTE members: `a > b` is emitted as
   `b < a` with the slots swapped (try_emit_binary_raw), so four cover eight operators. */
OPCODE(RAW_LT_INT_JUMP_IF_FALSE, raw_lt_int_jump_if_false, SCALED_B,
       "jump if !(rawi < rawi)", L_RAW_CMP_JUMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_LTE_INT_JUMP_IF_FALSE, raw_lte_int_jump_if_false, SCALED_B,
       "jump if !(rawi <= rawi)", L_RAW_CMP_JUMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_EQ_INT_JUMP_IF_FALSE, raw_eq_int_jump_if_false, SCALED_B,
       "jump if !(rawi == rawi)", L_RAW_CMP_JUMP(F_RAWI, F_RAWK_I))
OPCODE(RAW_NEQ_INT_JUMP_IF_FALSE, raw_neq_int_jump_if_false, SCALED_B,
       "jump if !(rawi != rawi)", L_RAW_CMP_JUMP(F_RAWI, F_RAWK_I))

/* A while loop's counter bump folded into its own back-edge: `counter += step` immediately
   followed by the rotated test of that same counter. A range-for already gets this from
   OP_ITER_RANGE_LOOP; the `for i < n:` form paid two dispatches for it.
   word0 = PACK3(op, counter, step, limit); word1 = jump target. */
OPCODE(RAW_INC_LTE_INT_JUMP_IF_FALSE, raw_inc_lte_int_jump_if_false, SCALED_A | SCALED_B | SCALED_C,
       "rawi += rawi, then jump if !(rawi <= it)",
       {AT_A, F_RAWI}, {AT_B, F_RAWI}, {AT_C, F_RAWI}, {AT_W1, F_JUMP})
OPCODE(RAW_LT_REAL_JUMP_IF_FALSE, raw_lt_real_jump_if_false, SCALED_B,
       "jump if !(rawr < rawr)", L_RAW_CMP_JUMP(F_RAWR, F_RAWK_D))
OPCODE(RAW_LTE_REAL_JUMP_IF_FALSE, raw_lte_real_jump_if_false, SCALED_B,
       "jump if !(rawr <= rawr)", L_RAW_CMP_JUMP(F_RAWR, F_RAWK_D))
OPCODE(RAW_EQ_REAL_JUMP_IF_FALSE, raw_eq_real_jump_if_false, SCALED_B,
       "jump if !(rawr == rawr)", L_RAW_CMP_JUMP(F_RAWR, F_RAWK_D))
OPCODE(RAW_NEQ_REAL_JUMP_IF_FALSE, raw_neq_real_jump_if_false, SCALED_B,
       "jump if !(rawr != rawr)", L_RAW_CMP_JUMP(F_RAWR, F_RAWK_D))

/* A typed array's element moves straight between the array and a slot, never becoming an
   AerVal just to be torn apart again. Bounds-checked, so no loop proof is needed -- an
   out-of-range index or a non-typed-array receiver falls through to the generic path.
   raw_int_slot, arr_reg, rk_idx */
OPCODE(INDEX_GET_RAW_INT, index_get_raw_int, SCALED_A | SCALED_B,
       "rawi = arr[rk] (checked)", {AT_A, F_RAWI}, {AT_B, F_REG}, {AT_C, F_RK8})
/* arr_reg, rk_idx, raw_int_slot */
OPCODE(INDEX_SET_RAW_INT, index_set_raw_int, SCALED_A | SCALED_C,
       "arr[rk] = rawi (checked)", {AT_A, F_REG}, {AT_B, F_RK8}, {AT_C, F_RAWI})
/* arr_reg, rk_idx, raw_real_slot */
OPCODE(INDEX_SET_RAW_REAL, index_set_raw_real, SCALED_A | SCALED_C,
       "arr[rk] = rawr (checked)", {AT_A, F_REG}, {AT_B, F_RK8}, {AT_C, F_RAWR})
/* raw_real_slot, arr_reg, rk_idx */
OPCODE(INDEX_GET_RAW_REAL, index_get_raw_real, SCALED_A | SCALED_B,
       "rawr = arr[rk] (checked)", {AT_A, F_RAWR}, {AT_B, F_REG}, {AT_C, F_RK8})

/* `arr[rk] OP= raw` in one dispatch, where a separate get, arithmetic and set cost three and
   box the element in between -- the trade OP_FIELD_COMPOUND already makes for a struct field,
   which an accumulator into an array element (a histogram bucket, a group-by total) needs just
   as often. ADD/SUB/MUL and the wide element kinds only; anything else takes the slow path.
   word0: arr_reg, bin_op, rk_idx -- word1: raw_int_slot */
OPCODE(INDEX_COMPOUND_RAW_INT, index_compound_raw_int, 0,
       "fused: arr[rk] OP= rawi (checked)", {AT_A, F_REG}, {AT_B, F_BINOP}, {AT_C, F_RK8}, {AT_W1, F_RAWI})
/* word0: arr_reg, bin_op, rk_idx -- word1: raw_real_slot */
OPCODE(INDEX_COMPOUND_RAW_REAL, index_compound_raw_real, 0,
       "fused: arr[rk] OP= rawr (checked)", {AT_A, F_REG}, {AT_B, F_BINOP}, {AT_C, F_RK8}, {AT_W1, F_RAWR})

/* Same variant, so the frame is the caller's own and no resolver runs -- without it a recursive
   function re-resolves every call, costing more than specializing saved. Emitted only INTO a
   variant: a generic body must keep resolving or it never specializes at all.
   dest_reg, arg_reg_base, arg_count */
OPCODE(CALL_SELF, call_self, 0,
       "recursive call into this same specialized body", {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT})
/* same operands as OP_CALL_SELF; dest_reg is unused */
OPCODE(TAIL_CALL_SELF, tail_call_self, 0,
       "tail call into this same specialized body, reuses this frame",
       {AT_A, F_REG}, {AT_B, F_REG}, {AT_C, F_COUNT})

/* Only the functions aer_math_fn_is_raw_real accepts -- floor/ceil/round return integers.
   dest_slot, src_slot, fn_id */
OPCODE(RAW_MATH_REAL, raw_math_real, 0,
       "rawr = math fn(rawr), never boxed", {AT_A, F_RAWR}, {AT_B, F_RAWR}, {AT_C, F_FN_ID})

/* int() truncates toward zero, matching OP_CAST's rule. */
OPCODE(RAW_INT_TO_REAL, raw_int_to_real, SCALED_A | SCALED_B,
       "rawr = (real)rawi", {AT_A, F_RAWR}, {AT_B, F_RAWI})
OPCODE(RAW_REAL_TO_INT, raw_real_to_int, 0, "rawi = (int)rawr, truncating", {AT_A, F_RAWI}, {AT_B, F_RAWR})

/* One string from N parts in one allocation: each part is a trailing RK16 word, so a constant
   segment needs no OP_LOADK and a non-string part formats straight into the result. Variable
   length like OP_DEFINE_STRUCT. Past INTERP_MAX_PARTS, parse_string_literal chains instead.
   word0: dest_reg, part_count -- then part_count words, each one RK16 */
OPCODE(INTERP, interp, 0, "reg = one string built from N parts", L_VARIABLE)

/* `dict["key_{n}"]` read: formats the key into a stack buffer and probes with the raw bytes,
   never building the AerString that existed only to be hashed. Falls back to OP_INTERP plus the
   general index path for a non-dict receiver, a collection part, or a key past INTERP_KEY_MAX.
   word0: dest_reg, obj_reg, part_count -- then part_count RK16 words */
OPCODE(INDEX_GET_INTERP, index_get_interp, 0, "reg = dict[N-part key], key never allocated", L_VARIABLE)
